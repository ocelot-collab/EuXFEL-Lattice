!================================================================================================
!
!----- July 2023
!
!----- Upgrade after SA2: SCU, new layout of T3MATCH1
!
!================================================================================================
!
! Beam Line to SASE2: Starting from second (first untilted) septum BZ.2.T1
!
! TD1: LINE = (T1, SA2, T3, UN1, T5, UN2, T5D)
!
!================================================================================================
!
!----- SOUTH line:
!      Vertical kickers KL:  upwards     (to positive Y)
!      Horizontal septa BZ:  to the left (to positive X)
!      Horizontal dipoles:   to the left (to positive X)
!      Vertical dipoles:     dogleg in the end of arc (opposite to kickers KL)
!
!      Setting of KL kickers and 1st septum (which are defined in TL file) is in this file.
!
!================================================================================================


!----- Vacuum Markers and Vacuum Components

VCST40T10.T1:   MARKER;          ! Transition 40 to 10 mm
VCST10T40.T3:   MARKER;
VCST10T22.T3:   MARKER;
VCST22T40.T3:   MARKER;
VCST40T93X.T3:  MARKER;
VCST93XT40.T3:  MARKER;
VCST40T93X.T5:  MARKER;
VCST93XT40.T5:  MARKER;
VCST98T98Y.T5D: MARKER;
VCST98YT98.T5D: MARKER;
VCST40T93Y.T5D: MARKER;
VCST93YT40.T5D: MARKER;
VCST40T98.T5D:  MARKER;
VCST98T200.T5D: MARKER;

VCBSHUT.T1: DRIFT, L=0.3;

!************************************************************************************************


!----- Definition of kickers KL

!--- Kickers KL (vertical): upwards (to positive y)

!LEN_KL = 0.93;     ! defined in DEFS file

cur_KL_matlab = -1.0958550725e-4;   ! from Matlab code

!cur_KL_matlab = -1.09585507250e-4*1.000962

!--- MAD definition VKICKER: positive VKICK to kick to positive Y

cur_KL_mad = -cur_KL_matlab;                   ! sign (+) for KL as Vkicker
ang_KL_mad = asin(cur_KL_mad*LEN_KL);          ! description used all time
!ang_KL_mad = 2*asin(0.5*cur_KL_mad*LEN_KL);   ! correct description for RBEND
arc_KL_mad = ang_KL_mad / cur_KL_mad;

!ANG_KL_TD1 =  ang_KL_mad;                     ! sign (+) for KL as Vkicker


!--- MAD definition RBEND:   negative ANGLE to kick to positive Y

ANG_KL_TD1 = -ang_KL_mad;                     ! sign (-) for KL as RBEND


!--- for info
NUM_KL =  5;
ANG_KL_TD1_tot = NUM_KL * ANG_KL_TD1;   ! 0.5095726095946186 mrad

!************************************************************************************************

comment
!----- Defined in XFEL_Run_South.txm  file

!----- Rotations of coordinate system: Have to be used only for SURVEY 

!--- In the front of 2d (1st untilted) T1 septum

!--- Nov 2016: New RotSystemTD1
az1  = -0.00440392786446921;
ay   = +9.27121409529346e-08;
az2  = +0.00441369699554469;

Rot.Z1.T1: Srot, angle = az1;
Rot.Y.T1:  Yrot, angle =  ay;
Rot.Z2.T1: Srot, angle = az2;

RotSystemTD1: Line = (Rot.Z1.T1, Rot.Y.T1, Rot.Z2.T1);


!---- At Sa2 entrance (at Sa2_Ursprung)

Rot.Y.Sa2:  Yrot, angle = -2.365095999996847e-06;   ! if RotSytemTD1 is used
endcomment

!************************************************************************************************


!---------- T1 line: (T1M, T1D)  (deflection arc and matching to SASE2) 
!---------- Start at the entrance of 2d (first untilted) septum


!----- Section and Subsection Markers

!STSEC.T1.T1: MARKER;    ! defined and used in NORTH file
!ENSEC.T1.T1: MARKER;    ! defined in NORTH file, used here

STSUB.T1U.T1:  MARKER;   ! Start of subsection upstream of septa
ENSUB.T1U.T1:  MARKER; 

STSUB.T1M.T1:  MARKER;   ! Start of bending section
ENSUB.T1M.T1:  MARKER; 

STSUB.T1D.T1:  MARKER;   ! Start of downstream section up to SA2 undulator
ENSUB.T1D.T1:  MARKER; 

!----- Diagnostic elements 

BPMA.T1:  MONITOR;
BPME.T1:  MONITOR;
OTRA.T1:  MARKER;
OTRB.T1:  MARKER;
OTRBW.T1: MARKER;
TORA.T1:  MARKER;
BCM.T1:   MARKER;


!----- Correctors (L_yoke is used)

CFX.T1: HKICKER, L = 0.100;
CFY.T1: VKICKER, L = 0.100;
CEX.T1: HKICKER, L = 0.100;
CEY.T1: VKICKER, L = 0.100;
CNY.T1: VKICKER, L = 0.300;


BSECT.T1: RBEND, L = 1.5, ANGLE=0;
ABSP.T1:  DRIFT, L = 0.05;

!------------------------------------------------------------------------------------------------


!-------- Deflection arc: T1M

!----- T1 septa

!--- Definition from Matlab code
 
cur_BZ_T1_matlab  = -0.0055;
tilt_BZ_T1_matlab = +(12.216344266902098 / 180.0) * pi;


!--- MAD definition

CUR_BZ_T1   = cur_BZ_T1_matlab;
!ANG_BZ_T1   = 2*asin(0.5*LEN_BZ*CUR_BZ_T1);     ! for E1=E2=angle/2
ANG_BZ_T1   = asin(LEN_BZ*CUR_BZ_T1);            ! for E1=0,E2=angle, -0.005500027729544
ARC_BZ_T1   = ANG_BZ_T1 / CUR_BZ_T1;
E12_BZ_T1   = ANG_BZ_T1 / 2;
TILT_BZ1_T1 = tilt_BZ_T1_matlab;


BZ.1.T1: Sbend, L  = ARC_BZ_T1, ANGLE = ANG_BZ_T1,  &
                E1 = 0, E2 = ANG_BZ_T1,             & 
                TILT = TILT_BZ1_T1;

BZ.2.T1: Sbend, L  = ARC_BZ_T1, ANGLE = ANG_BZ_T1,  &
                E1 = E12_BZ_T1, E2 = E12_BZ_T1;          ! still not correct


!----- Dipoles in TM1 arc

cur_HH_matlab  = -0.00582795620785501;    ! horizontal to positive x
cur_HN_matlab  = +0.00303654808331367;    ! horizontal for R56
cur_HV_matlab  = +0.00191331423981618;    ! vertical, dogleg

CUR_BD1_T1 = cur_HH_matlab;
CUR_BD2_T1 = cur_HN_matlab;
CUR_BD3_T1 = cur_HV_matlab;


!--- 4 main horizontal dipoles

!LEN_BD = 1.0;    ! defined in DEFS file

ANG_BD1_T1 = 2*asin(0.5*LEN_BD*CUR_BD1_T1);    ! E1=E2=angle/2
ARC_BD1_T1 = ANG_BD1_T1/CUR_BD1_T1;
E12_BD1_T1 = ANG_BD1_T1/2;

BD.1.T1: Sbend, L  = ARC_BD1_T1, ANGLE = ANG_BD1_T1,   &
                E1 = E12_BD1_T1, E2 = E12_BD1_T1;


!--- 2 weak horizontal dipoles for R_56 = 0

ANG_BD2_T1 = 2*asin(0.5*LEN_BD*CUR_BD2_T1);
ARC_BD2_T1 = ANG_BD2_T1/CUR_BD2_T1;
E12_BD2_T1 = ANG_BD2_T1/2;

BD.2.T1: Sbend, L  = ARC_BD2_T1, ANGLE = ANG_BD2_T1,   &
                E1 = E12_BD2_T1, E2 = E12_BD2_T1;


!--- 2 vertical dipoles (dogleg in arc end)

ANG_BD3_T1 = 2*asin(0.5*LEN_BD*CUR_BD3_T1);
ARC_BD3_T1 = ANG_BD3_T1/CUR_BD3_T1;
E12_BD3_T1 = ANG_BD3_T1/2;

BD.3.T1: Sbend, L  = ARC_BD3_T1,  ANGLE = ANG_BD3_T1,  &
                E1 = E12_BD3_T1,  E2 = E12_BD3_T1,     &
                TILT = PI/2;
BD.4.T1: Sbend, L  = ARC_BD3_T1,  ANGLE = -ANG_BD3_T1, &
                E1 = -E12_BD3_T1, E2 = -E12_BD3_T1,    &
                TILT = pi/2;


!----- Quadrupoles

comment
!--- Setting using HELP elements
QF.1.T1: Quadrupole, L = L_QF_eff, K1 = +0.315243141957;
QF.2.T1: Quadrupole, L = L_QF_eff, K1 = -0.323611590970;
QF.3.T1: Quadrupole, L = L_QF_eff, K1 = +0.154417950171;
QF.4.T1: Quadrupole, L = L_QF_eff, K1 = -0.338823188903;
QF.5.T1: Quadrupole, L = L_QF_eff, K1 = +0.282318683934;
QF.6.T1: Quadrupole, L = L_QF_eff, K1 = -0.194938449486;
endcomment


!--- October 2021: Setting using combine function magnets
QF.1.T1: Quadrupole, L = L_QF_eff, K1 = +0.315212937052;
QF.2.T1: Quadrupole, L = L_QF_eff, K1 = -0.323691912286;
QF.3.T1: Quadrupole, L = L_QF_eff, K1 = +0.154546097544;
QF.4.T1: Quadrupole, L = L_QF_eff, K1 = -0.338927657260;
QF.5.T1: Quadrupole, L = L_QF_eff, K1 = +0.282283084630;
QF.6.T1: Quadrupole, L = L_QF_eff, K1 = -0.194860954918;


!----- Sextupoles and Octupoles

SA.1.T1: Sextupole, L = L_SA_eff, K2 = -6.30076543678647*0.3/0.3164, &
                    TILT= -(5.5/180.0)*pi;
SA.2.T1: Sextupole, L = L_SA_eff, K2 = -1.80251860700197*0.3/0.3164, &
                    TILT= -(18.5/180.0)*pi;

OA.1.T1: Octupole,  L = L_OA_eff, K3 = -140.391458503124*0.2/0.2113, &
                    TILT= -(8.0/180.0)*pi;
OA.2.T1: Octupole,  L = L_OA_eff, K3 = -197.469340771742*0.2/0.2113, &
                    TILT= -(15.5/180.0)*pi


!----- These magical drifts are used to keep the fit of
!      the extraction arc geometry with high precition

T1.L2:  Drift, L = 1.84067814816517-0.325+0.1-0.125;
T1.L3:  Drift, L = 4.64940475946167-0.270;
T1.L4:  Drift, L = 3.21001579387043-0.325-0.125;
T1.L5:  Drift, L = 4.93473350835321+0.1-0.125;
T1.L7:  Drift, L = 1.51118177548686-0.325-0.125;
T1.L8:  Drift, L = 7.48842436400046-0.270;

!--- Adjustment of drift to fit the geometry  
D4750C: Drift, L = 4.750 - 1.4e-5;


T1M: Line = (BZ.2.T1, D0500, BZ.2.T1, D0500, BZ.2.T1, D4750C,     &   ! three untilted septa
             TORA.T1, D0500, OTRA.T1, D1675,                      &
             D0100,BPMA.T1,D0100,                                 &
             fD0125, QF.1.T1, fD0125, D0045, CFX.T1,              &
             D1105, oD0125, OA.1.T1, oD0125, T1.L2,               &
             D0100,BPMA.T1,D0100,                                 &
             fD0125, QF.2.T1, fD0125, D0045, CFY.T1, T1.L3,       &
             BD.2.T1, D0740, sD0125, SA.1.T1, sD0125, T1.L4,      &   ! 1st weak horizonatal dipole
             D0100,BPMA.T1,D0100,                                 &
             fD0125, QF.3.T1, fD0125, D0045, CFX.T1,              &
             D0105, oD0125, OA.2.T1, oD0125, T1.L5,               &
             BD.2.T1, D0175, D0100,BPMA.T1,D0100,                 &   ! 2d  weak horizontal dipole
             fD0125, QF.4.T1, fD0125, D0045, CFY.T1,              &
             D3215, sD0125, SA.2.T1, sD0125, T1.L7,               &
             D0100,BPMA.T1,D0100,                                 &
             fD0125, QF.5.T1, fD0125, D0045, CFX.T1, T1.L8,       &
             BD.1.T1,D0500,BD.1.T1,D0500,BD.1.T1,D0500,BD.1.T1,   &   ! four main horizontal dipoles
             D0175, D0100,BPMA.T1,D0100,                          &
             fD0125, QF.6.T1, fD0125, D0045, CFY.T1, D0230,       &
             BD.3.T1,                                             &   ! 1st vertical dipole 
             D3520, D0100,BPMA.T1,D0100, D0170, CFX.T1,           &
             D3320, D0100,BPMA.T1,D0100, D0170, CFY.T1,           &
             D0200, D3520, BD.4.T1, ENSUB.T1M.T1)                  ! 2d  vertical dipole

!************************************************************************************************


!-------- Matching section from T1M to SASE2


!----- Diagnostic undulator with natural focusing
   
!--- 3 pairs of poles
!    Period  = 40 mm
!    Gap = 12 mm  =>  B_0 = 0.96 T, K = 3.2784
   
LundS     = 0.040;
NundS     = 3;            ! 0.34 = 3*0.04+0.11+0.11
LundS_3 = LundS * NundS;  ! L = 0.120
   
KundS    = 3.2784;
kQundS   = (2*pi*KundS)/(LundS*gammaUnd*betaUnd);
OmegaS   = kQundS / sqrt(2);
   
!--- Initial beta_y:
r11_udia = cos(OmegaS*LundS);
r12_udia = sin(OmegaS*LundS) / OmegaS;
Beta0_udia = r12_udia / sqrt(1.0 - r11_udia * r11_udia);
!value, beta0_udia;

   
U40S.T1: MATRIX, L = LundS_3,            &
   RM(1,1) = 1.0,                        &
   RM(1,2) = LundS_3,                    &
   RM(1,3) = 0.0,                        &
   RM(2,2) = 1.0,                        &
   RM(3,3) = cos(OmegaS*LundS_3),        &
   RM(3,4) = sin(OmegaS*LundS_3)/OmegaS, &
   RM(4,3) =-sin(OmegaS*LundS_3)*OmegaS, &
   RM(4,4) = cos(OmegaS*LundS_3);


!----- Quadrupoles 

comment
!--- Setting: Undulator SASE2 open (default)
!--- Setting using HELP elements
QF.7.T1:  Quadrupole, L = L_QF_eff, K1 = +0.171381255406;
QF.8.T1:  Quadrupole, L = L_QF_eff, K1 = -0.166973632918;
QF.9.T1:  Quadrupole, L = L_QF_eff, K1 = +0.130656552797;
QF.10.T1: Quadrupole, L = L_QF_eff, K1 = -0.125264906509;
QF.11.T1: Quadrupole, L = L_QF_eff, K1 = +0.117592144099;
QF.12.T1: Quadrupole, L = L_QF_eff, K1 = -0.127116504030;
QF.13.T1: Quadrupole, L = L_QF_eff, K1 = +0.122225797317;

QA.1.T1:  Quadrupole, L = L_QA_eff, K1 = -0.562055063894;   ! = QA.1.SA2
QA.2.T1:  Quadrupole, L = L_QA_eff, K1 = +0.562055063894;   ! = QA.1.SA2
endcomment


!--- Setting: Undulator SASE2 open (default)
!--- October 2021: Setting using combine function magnets
QF.7.T1:  Quadrupole, L = L_QF_eff, K1 = +0.171153186152;  
QF.8.T1:  Quadrupole, L = L_QF_eff, K1 = -0.167472320210;
QF.9.T1:  Quadrupole, L = L_QF_eff, K1 = +0.129996637517;  
QF.10.T1: Quadrupole, L = L_QF_eff, K1 = -0.125775289179;
QF.11.T1: Quadrupole, L = L_QF_eff, K1 = +0.116813193011;
QF.12.T1: Quadrupole, L = L_QF_eff, K1 = -0.127288659597;  
QF.13.T1: Quadrupole, L = L_QF_eff, K1 = +0.120201667196;

QA.1.T1:  Quadrupole, L = L_QA_eff, K1 = -0.562055063894;   ! = QA.1.SA2
QA.2.T1:  Quadrupole, L = L_QA_eff, K1 = +0.562055063894;   ! = QA.1.SA2

!----- Quadrupole movers
CMVQA.T1: KICKER, L=0;

T1D: Line = (STSUB.T1D.T1,                                &
             D0175,                                       &
             QFSEC(BPMA.T1,QF.7.T1,CFX.T1),               &
             D2000,D0250, D0900, BSECT.T1, D6215,         &
             QFSEC(BPMA.T1,QF.8.T1,CFY.T1),               &
             D0460,D6030,D0200,OTRBW.T1,D0400, D6275,      &   ! 1st screen
             QFSEC(BPMA.T1,QF.9.T1,CFX.T1),               &
             D44882,VCBSHUT.T1,D17018,D0200,D0400, D6275, &   
             QFSEC(BPMA.T1,QF.10.T1,CFY.T1),              &
             D6490, D0200,OTRBW.T1,D0400, D6275,          &   ! 2d  screen
             QFSEC(BPMA.T1,QF.11.T1,CFX.T1),              &
             D6490, D0200,OTRBW.T1,D0400, D6275,          &   ! 3rd screen
             QFSEC(BPMA.T1,QF.12.T1,CFY.T1),              &
             D5190, D0200,OTRBW.T1,D0400, D4975,          &   ! 4th screen
             QFSEC(BPMA.T1,QF.13.T1,CFX.T1),              &
             D3980, BPMA.T1, D0615,                       & !!! Insert for BPM and Beam Stop in in front of SASE2
             VCBSHUT.T1, D4379625,                        & !!!
             D0300,TORA.T1,D000675, D0500,                &
             D0100,VCST40T10.T1, D009975,                 &
             D0100,BPME.T1,D0100,                         &
             aD0125, QA.1.T1, CMVQA.T1, aD0125,           &
             D0035, D0025,CNY.T1,D0125,CEX.T1,D20575,     & 
             D0110, U40S.T1, D0110,                       &
             D17167,CNY.T1,D0150,CEX.T1,D0160,D0050, ABSP.T1,&
             D01723, BPME.T1, aD01935, QA.2.T1, CMVQA.T1, aD0047, &
             ENSUB.T1D.T1                               );          


!----- Section T1: Deflection arc and matching section to SASE2 

!--- T1 without RotSystemTD1 at T1M start: Twiss functions
T1:  Line = (T1M, T1D, ENSEC.T1.T1);

comment
!--- T1 with RotSystemTD1 at T1M start: for SURVEY, defined in Run file
T1_survey: Line = (RotSystemTD1, T1M, T1D, ENSEC.T1.T1);
endcomment

!************************************************************************************************

!------------------------------------------------------------------------------------------------
!
!-------- SASE2 undulator (37 cells)
!
!-------- January 2019: Undulator segments
!                       from CELL9  => CELL1
!                       from CELL18 => CELL2
!                       Chicanes are installed in CELL9 and CELL18.
!          
!-------- August 2016: CELL1 and CELL2 are without undulator segments
!
!------------------------------------------------------------------------------------------------

!----- Section and Subsection Markers

STSEC.SA2.SA2: MARKER;
ENSEC.SA2.SA2: MARKER;
STUCELL.SA2:   MARKER;
ENUCELL.SA2:   MARKER;


!----- Matching Markers

MATCH.UND.SA2: Marker;
  

!----- Steerer
CAX.SA2: HKICKER, L=0.025;
CAY.SA2: VKICKER, L=0.025;
CBX.SA2: HKICKER, L=0.025;
CBY.SA2: VKICKER, L=0.025;
CUX.SA2: HKICKER, L=0.000;
 
!----- Quadrupole movers
CMVQA.SA2: KICKER, L=0;

!----- MONITOR
BPME.SA2: MONITOR;

!----- Phase Shifter
BPS.SA2: DRIFT, L=0.23;

!----- ABSORBER
ABSP.SA2: DRIFT, L=0.05;
ABSP4.SA2: DRIFT, L=0.05;

!------------------------------------------------------------------------------------------------

!----- Model for undulator field (natural focusing)

!--- Undulator closed (with natural focusing)
!    - model for U40.SA2 has to be set in SET_MODEL_SA2.txm
!    - matching has to be done to periodic solution in SA2
!    - one example: call, "SET_SA2_closed_14GeV_136_b32.txm"
 

!--- Undulator open (no natural focusing)

U40.SA2: Drift, L = 5.0;


!--- Definition of undulator segment: Open Default

UNDU.SA2: Line = (U40.SA2);

!------------------------------------------------------------------------------------------------


!----- Quadrupoles

!--- Setting of quadrupoles depends on energy, undulator gap, betatron functions

!--- Undulator SASE2 open (default), mean beta-function 32 m
QA.1.SA2: Quadrupole, L = L_QA_eff, K1 = -0.562055063894;
QA.2.SA2: Quadrupole, L = L_QA_eff, K1 = +0.562055063894;

!------------------------------------------------------------------------------------------------


!-------- SA2 Lattice


!----- Definition of CELL with undulator segments and intersecton: in DEFS file
!      (used in SA1, SA2, SA3)

comment   ! here for info
!--- New Section definition necessary to correctly handle start/end markers
UNDSEC(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,PHS,END): LINE = &
    (START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,             &
     D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047,              &
     D0058, PHS, D000472, END);

!--- Last Undulator CELL ends before the phase shifter
UNDSECE(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,END): LINE =    &
    (START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,             &
     D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047, END);
endcomment

comment
!--- Old definition
UNDSEC(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,PHS,END): LINE =   &
   (D0058, PHS, D000472, END,                                          &
    START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,                &
    D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047);
endcomment

!------------------------------------------------------------------------------------------------


!----- Undulator chicane

!LEN_BS  = 0.3;      ! defined in DEFS file

BS: SBEND, L = LEN_BS, ANGLE = 0, &   
           E1 = 0, E2 = 0, TILT = 0;

D01485: DRIFT, L = 0.1485;
D12375: DRIFT, L = 1.2375;
D0435:  DRIFT, L = 0.4350;
D0290:  DRIFT, L = 0.2900;
D01515: DRIFT, L = 0.1515;

SEEDCHIC(BS.1,CBS.1,BS.2,CBS.2,BS.3,CBS.3,BS.4,CBS.4,D12375,BPM,MONO): &
   LINE = (D01485,                                 &
           BS.1,CBS.1, D12375, BS.2,CBS.2,         &
           D0290, BPM, D0300, MONO, D0435,         &
           BS.3,CBS.3, D12375, BS.4,CBS.4, D01515);

!------------------------------------------------------------------------------------------------


!----- January 2019: Undulator segments from CELL9 and CELL18 are moved in the front

!----- Description without undulators segments: 
!      not needed anymore, but kept here for studies

!--- Undulator segment as 5 m drift
!UNDULATOR: DRIFT, L = 5.0;
!U00.SA2: UNDULATOR;

!--- Undulator segment is devided in two parts
!    for checking of SASE2_Ursprung (deltaZ=2.8905m)

U00.SA2: Marker;

U00Line.SA2: Line = (D2500, U00.SA2, D2500);

U00Line.SA2.1: Line = (D2500, U00.SA2, D2500);
U00Line.SA2.2: Line = (D2500, U00.SA2, D2500);

!--- First cell with Rot element
!U00Line.SA2.1: Line = (D2500, Rot.Y.Sa2, U00.SA2, D2500)


!--- Cells without undulator segment

SA2DRIF1: LINE = &
  (UNDSEC(STUCELL.SA2, D0025,D0025, U00Line.SA2, D0025,D0025, CUX.SA2, &
          ABSP.SA2, BPME.SA2, &
          QA.1.SA2, CMVQA.SA2, D0230, ENUCELL.SA2));

SA2DRIF2: LINE = &
  (UNDSEC(STUCELL.SA2, D0025,D0025, U00Line.SA2, D0025,D0025, CUX.SA2, &
          ABSP.SA2, BPME.SA2, &
          QA.2.SA2, CMVQA.SA2, D0230, ENUCELL.SA2));

!--- New description: Periodic solutions at the entrance of CAX.SA2
dofo_SA2_open: Line =(SA2DRIF1, SA2DRIF2);   ! first quad defocusing
fodo_SA2_open: Line =(SA2DRIF2, SA2DRIF1);   ! first quad   focusing

!------------------------------------------------------------------------------------------------


!----- Cells with Self-Seeding chicanes  

BPMH.SA2:  MONITOR;
MONO1.SA2: MARKER;
MONO2.SA2: MARKER;


!----- First chicane

MCBS.1.SA2: MARKER;
CBS.2.SA2:  HKICKER, L=0.0;
CBS.3.SA2:  HKICKER, L=0.0;
CBS.4.SA2:  HKICKER, L=0.0;


!LEN_BS  = 0.3;      ! defined in DEFS file

ang_chic1 = 0.0;
arc_chic1 = LEN_BS;     !/sin(ang_chic1)*ang_chic1;

BS.1.1.SA2: SBEND, L = arc_chic1, ANGLE = ang_chic1, &
                   E1 = 0, E2 = ang_chic1, TILT = 0;
BS.1.2.SA2: SBEND, L = arc_chic1, ANGLE =-ang_chic1, &
                   E1 = -ang_chic1, E2 = 0, TILT = 0;
BS.1.3.SA2: SBEND, L = arc_chic1, ANGLE =-ang_chic1, &
                   E1 = 0, E2 =-ang_chic1, TILT = 0;
BS.1.4.SA2: SBEND, L = arc_chic1, ANGLE = ang_chic1, &
                   E1 = ang_chic1, E2 = 0, TILT = 0;
           
deltachic = 1.2375;
CD12375I1 = deltachic / cos(ang_chic1);
D12375I1:  DRIFT, L = CD12375I1;

CHIC.1.SA2: LINE= &
 (SEEDCHIC(BS.1.1.SA2,MCBS.1.SA2, BS.1.2.SA2,CBS.2.SA2, &
           BS.1.3.SA2,CBS.3.SA2,  BS.1.4.SA2,CBS.4.SA2, &
           D12375I1, BPMH.SA2, MONO1.SA2));


!--- CELL9 with first chicane

SA2SECSEED1: LINE = &
  (UNDSEC(STUCELL.SA2, D0025,D0025, CHIC.1.SA2, D0025,D0025,D0000, &
          ABSP.SA2, BPME.SA2, QA.1.SA2, CMVQA.SA2, BPS.SA2, ENUCELL.SA2));   ! defocusing quad


!--- Second chicane

MCBS.5.SA2: MARKER;
CBS.6.SA2:  HKICKER, L=0.0;
CBS.7.SA2:  HKICKER, L=0.0;
CBS.8.SA2:  HKICKER, L=0.0;

ng_chic2 = 0.0;
arc_chic2 = LEN_BS  !/sin(ang_chic2)*ang_chic2;

BS.2.1.SA2: SBEND, L = arc_chic2, ANGLE = ang_chic2, &
                   E1 = 0, E2 = ang_chic2, TILT = 0;
BS.2.2.SA2: SBEND, L = arc_chic2, ANGLE =-ang_chic2, & 
                   E1 = -ang_chic2, E2 = 0, TILT = 0;
BS.2.3.SA2: SBEND, L = arc_chic2, ANGLE =-ang_chic2, &
                   E1 = 0, E2 =-ang_chic2, TILT = 0;
BS.2.4.SA2: SBEND, L = arc_chic2, ANGLE = ang_chic2, &
                   E1 = ang_chic2, E2 = 0, TILT = 0;

!deltachic = 1.2375;
CD12375I2 = deltachic / cos(ang_chic2);
D12375I2:  DRIFT, L = CD12375I2;

CHIC.2.SA2: LINE=&
  (SEEDCHIC(BS.2.1.SA2,MCBS.5.SA2, BS.2.2.SA2,CBS.6.SA2, &
            BS.2.3.SA2,CBS.7.SA2,  BS.2.4.SA2,CBS.8.SA2, &
            D12375I2, BPMH.SA2, MONO2.SA2));


!--- CELL18 with second chicane

SA2SECSEED2: LINE = &
  (UNDSEC(STUCELL.SA2, D0025,D0025, CHIC.2.SA2, D0025,D0025,D0000, &
          ABSP.SA2, BPME.SA2, QA.2.SA2, CMVQA.SA2, BPS.SA2, ENUCELL.SA2));

!------------------------------------------------------------------------------------------------


!----- Cells with undulator segments

!--- Cell with defocusing (horizontal) quadrupole (L = 6.1 m)
SA2SEC1: LINE = &
  (UNDSEC(STUCELL.SA2, CAX.SA2, CAY.SA2, UNDU.SA2,  &
          CBX.SA2, CBY.SA2, CUX.SA2,                &
          ABSP.SA2, BPME.SA2,                       &
          QA.1.SA2, CMVQA.SA2, BPS.SA2, ENUCELL.SA2));

!--- Cell in the front of chicane without phase shifter BPS.SA2 => D0230
SA2SEC1A: LINE = &
  (UNDSEC(STUCELL.SA2, CAX.SA2, CAY.SA2, UNDU.SA2,  &
          CBX.SA2, CBY.SA2, CUX.SA2,                &
          ABSP.SA2, BPME.SA2,                       &
          QA.1.SA2, CMVQA.SA2, D0230, ENUCELL.SA2));

!--- Cell with defocusing (horizontal) quadrupole (L = 6.1 m), no undulator
SA2SEC1O: LINE = &
  (UNDSEC(STUCELL.SA2, D0025, D0025, U00Line.SA2,  &
          D0025, D0025,  D0000,                &
          ABSP.SA2, BPME.SA2,                       &
          QA.1.SA2, CMVQA.SA2, D0230, ENUCELL.SA2));

!--- Cell with smaller absorber and without phase shifter BPS.SA2 => D0230
SA2SEC1B: LINE = &
  (UNDSEC(STUCELL.SA2, CAX.SA2, CAY.SA2, UNDU.SA2,  &
          CBX.SA2, CBY.SA2, CUX.SA2,                &
          ABSP4.SA2, BPME.SA2,                       &
          QA.1.SA2, CMVQA.SA2, D0230, ENUCELL.SA2));

!--- Cell with focusing (horizontal) quadrupole
SA2SEC2: LINE = &
  (UNDSEC(STUCELL.SA2, CAX.SA2, CAY.SA2, UNDU.SA2, &
          CBX.SA2, CBY.SA2, CUX.SA2,               &
          ABSP.SA2, BPME.SA2,                      &
          QA.2.SA2, CMVQA.SA2, BPS.SA2, ENUCELL.SA2));

!--- Cell with focusing (horizontal) quadrupole, no undulator
SA2SEC2O: LINE = &
  (UNDSEC(STUCELL.SA2, D0025, D0025, U00Line.SA2,  &
          D0025, D0025,  D0000,                &
          ABSP.SA2, BPME.SA2,                      &
          QA.2.SA2, CMVQA.SA2, D0230, ENUCELL.SA2));

!--- Cell in the front of chicane without phase shifter BPS.SA2 => D0230
SA2SEC2A: LINE = &
  (UNDSEC(STUCELL.SA2, CAX.SA2, CAY.SA2, UNDU.SA2, &
          CBX.SA2, CBY.SA2, CUX.SA2,               &
          ABSP.SA2, BPME.SA2,                      &
          QA.2.SA2, CMVQA.SA2, D0230, ENUCELL.SA2));

!--- Last Undulator cell ends before the phase shifter (L = 5.80728 m)
SA2SEC1E: LINE = &
  (UNDSECE(STUCELL.SA2, CAX.SA2, CAY.SA2, UNDU.SA2, &
          CBX.SA2, CBY.SA2, CUX.SA2,                &
          ABSP4.SA2, BPME.SA2,                      &
          QA.1.SA2, CMVQA.SA2, ENUCELL.SA2));


!--- New desciption: Periodic solution at the entrance of CAX.SA2
dofo_SA2_close: Line =(SA2SEC1, SA2SEC2);    ! first quadrupole defocusing
fodo_SA2_close: Line =(SA2SEC2, SA2SEC1);    ! first quadrupole   focusing

!------------------------------------------------------------------------------------------------


!----- 19.05.2023. SCU undulators

!--- Not final layout
!--- 8 cells WD 040923: 6 cells
!--- Length of intersection: 1.5 m WD 040923: 1.38 m
!--- length of cell: 6.38 m
!--- Total length: 6.5*6 = 38.28 m
!--- Additional drift of 0.28 m (1.38 m - 1.1 m)
!    is simply added to the drift D0058
!    in the end of intersection
 
!--- to Winni, naming in SCU section ?

STSUB.SCU.SA2: Marker;
ENSUB.SCU.SA2: Marker;     

!----- SCU: 5 m drift

SCU.SA2: Drift, L = 5.0;   

!--- Intersection: 1.5 m
D0458:   DRIFT, L = 0.458;    ! 0.058 + 0.400

D028472:   DRIFT, L = 0.28472  !

!--- New description
!UNDSCU(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,PHS,END): LINE = &
! (START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,                &
! D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047,                  &
! D0058, PHS, D028472, END);

D004778a: DRIFT, L= 0.04778+ 0.185
D00467a: DRIFT, L=0.0467+0.085
D028472a: DRIFT, L=0.28472-0.28

UNDSCU(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,PHS,END): LINE = &
 (START, D0010, CAX,CAY, D004778a, CL, UNDU, D00467a, CBX,CBY,                &
 D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047,                  &
 D0058, PHS, D028472a, END);

! Last Cell Ends before the phase shifter
UNDSCUE(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,END): LINE =    &
 (START, D0010, CAX,CAY, D004778a, CL, UNDU, D00467a, CBX,CBY,                &
 D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047, END);


!----- SCU Cell with undulator segments, no PS

! Mid Position of phase shifters as marker
MBPS.SA2: MARKER

D0230MBPS: LINE =(D0115, MBPS.SA2, D0115)

SCUSEC1: LINE = &
  (UNDSCU(STucell.SA2, CAX.SA2, CAY.SA2, SCU.SA2, &
          CBX.SA2, CBY.SA2, D0000, &
          ABSP.SA2, BPME.SA2,        &
          QA.1.SA2, CMVQA.SA2, D0230MBPS, ENucell.SA2));

SCUSEC2: LINE = &
  (UNDSCU(STucell.SA2, CAX.SA2, CAY.SA2, SCU.SA2, &
          CBX.SA2, CBY.SA2, D0000, &
          ABSP.SA2, BPME.SA2,        &
          QA.2.SA2, CMVQA.SA2, D0230MBPS, ENucell.SA2));

! Last cells without undulator

SCUSEC1A: LINE = &
  (UNDSCU(STucell.SA2, D0025, D0025, U00Line.SA2, &
          D0025, D0025, D0000, &
          ABSP.SA2, BPME.SA2,        &
          QA.1.SA2, CMVQA.SA2, D0230MBPS, ENucell.SA2));

SCUSEC2A: LINE = &
  (UNDSCU(STucell.SA2, D0025, D0025, U00Line.SA2, &
          D0025, D0025 , D0000, &
          ABSP.SA2, BPME.SA2,        &
          QA.2.SA2, CMVQA.SA2, D0230MBPS, ENucell.SA2));

!--- Last cell ends before the phase shifter (L = 6.20728 m)
SCUSEC1E: LINE = &
  (UNDSCUE(STucell.SA2, D0025, D0025, U00Line.SA2,   &
          D0025, D0025, D0000,                   &
          ABSP4.SA2, BPME.SA2,                         &
          QA.1.SA2, CMVQA.SA2, ENucell.SA2));


dofo_SCU_close: Line =(SCUSEC1, SCUSEC2);
fodo_SCU_close: Line =(SCUSEC2, SCUSEC1);

D00975:DRIFT, L=0.0975
D01825:DRIFT, L=0.1825
!SCU: LINE = (STSUB.SCU.SA2, D00975, SCUSEC2, &
!             2*(SCUSEC1A, SCUSEC2A), SCUSEC1E, &
!             D01825, ENSUB.SCU.SA2);

SCU: LINE = (STSUB.SCU.SA2, SCUSEC2A, &
             2*(SCUSEC1A, SCUSEC2A), SCUSEC1E, &
             ENSUB.SCU.SA2);
!------------------------------------------------------------------------------------------------


!----- SA2 SELF SEEDING

!----- SCU added just after SA2

!--- CELL1 and CELL2 with undulator segments
!--- CELL9  with chicane
!--- CELL18 with chicane
!--- Matching point at the start of CELL1
!--- (moved for 0.29272 m in the new description)  


!--- July 2023. SA2 with SCU
!--- SA2: Last cell is standard last cell SA2SEC1 with phase shifter   ! to Winni
!--- SCU: Last cell ends before the phase shifter


!--- SA2 with SCU
SA2: LINE = (STSEC.SA2.SA2, D029272, MATCH.UND.SA2, &
             SA2SEC1O, SA2SEC2O,                      &
             3*(SA2SEC1, SA2SEC2),                  &
             SA2SEC1, SA2SEC2A, SA2SECSEED1,        &   ! first chicane in CELL9
             3*(SA2SEC2, SA2SEC1),                  & 
             SA2SEC2, SA2SEC1A, SA2SECSEED2,        &   ! second chicane in CELL18
             9*(SA2SEC1, SA2SEC2), SA2SEC1B,       &   ! standard cell in the end
             SCU, ENSEC.SA2.SA2);                      ! SCU


!--- Description without D029272 to see the periodic solution in SA2 
SA2_CAX: LINE = (STSEC.SA2.SA2, MATCH.UND.SA2,      &
                 SA2SEC1O, SA2SEC2O,                  &
                 3*(SA2SEC1, SA2SEC2),              &
                 SA2SEC1, SA2SEC2A, SA2SECSEED1,    &   ! first chicane in CELL9
                 3*(SA2SEC2, SA2SEC1),              & 
                 SA2SEC2, SA2SEC1A, SA2SECSEED2,    &   ! second chicane in CELL18
                 9*(SA2SEC1, SA2SEC2), SA2SEC1B,     &
                 SCU, ENSEC.SA2.SA2);


comment
SA2_survey: LINE = (STSEC.SA2.SA2, ROT.Y.SA2, D029272, & 
                    MATCH.UND.SA2, SA2SEC1, SA2SEC2,   &
                    2*(SA2SEC1, SA2SEC2),              &
                    SA2SEC1, SA2SEC2A, SA2SECSEED1,    &
                    3*(SA2SEC2, SA2SEC1),              & 
                    SA2SEC2, SA2SEC1A, SA2SECSEED2,    & 
                    9*(SA2SEC1, SA2SEC2), SA2SEC1,     &
                    SCU, ENSEC.SA2.SA2);
endcomment


comment
!--- At present
!--- SA2 without SCU
SA2: LINE = (STSEC.SA2.SA2, D029272, MATCH.UND.SA2, &
             SA2SEC1, SA2SEC2,                      &
             2*(SA2SEC1, SA2SEC2),                  &
             SA2SEC1, SA2SEC2A, SA2SECSEED1,        &   ! first chicane in CELL9
             3*(SA2SEC2, SA2SEC1),                  & 
             SA2SEC2, SA2SEC1A, SA2SECSEED2,        &   ! second chicane in CELL18
             9*(SA2SEC1, SA2SEC2), SA2SEC1E,        &
             ENSEC.SA2.SA2);
!--- Description without D029272 to see the periodic solution in SA2 
SA2_CAX: LINE = (STSEC.SA2.SA2, MATCH.UND.SA2,      &
                 SA2SEC1, SA2SEC2,                  &
                 2*(SA2SEC1, SA2SEC2),              &
                 SA2SEC1, SA2SEC2A, SA2SECSEED1,    &   ! first chicane in CELL9
                 3*(SA2SEC2, SA2SEC1),              & 
                 SA2SEC2, SA2SEC1A, SA2SECSEED2,    &   ! second chicane in CELL18
                 9*(SA2SEC1, SA2SEC2), SA2SEC1E,    &
                 ENSEC.SA2.SA2);
SA2_survey: LINE = (STSEC.SA2.SA2, ROT.Y.SA2, D029272, & 
                    MATCH.UND.SA2, SA2SEC1, SA2SEC2,   &
                    2*(SA2SEC1, SA2SEC2),              &
                    SA2SEC1, SA2SEC2A, SA2SECSEED1,    &
                    3*(SA2SEC2, SA2SEC1),              & 
                    SA2SEC2, SA2SEC1A, SA2SECSEED2,    & 
                    9*(SA2SEC1, SA2SEC2), SA2SEC1E,    &
                    SCU, ENSEC.SA2.SA2);
endcomment


comment
!--- Old description of SA2
!--- SA2: Twiss functions
! SA2: LINE = (STSEC.SA2.SA2, MATCH.UND.SA2, SA2SEC1E, SA2SEC2,  &
!             3*(SA2SEC1, SA2SEC2), SA2SECSEED1, &
!             4*(SA2SEC2, SA2SEC1), SA2SECSEED2, &  
!             9*(SA2SEC1, SA2SEC2), SA2SEC1, ENSEC.SA2.SA2)
!----- SA2 with ROT.Y.SA2 in the front of CELL1: for SURVEY, defined in Run file 
! SA2_survey: LINE = (STSEC.SA2.SA2, ROT.Y.SA2, MATCH.UND.SA2, SA2SEC1E, SA2SEC2,  &
!                    3*(SA2SEC1, SA2SEC2), SA2SECSEED1, &
!                    4*(SA2SEC2, SA2SEC1), SA2SECSEED2, &  
