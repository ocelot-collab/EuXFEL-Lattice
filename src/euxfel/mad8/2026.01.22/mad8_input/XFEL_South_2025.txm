endcomment

!================================================================================================


!------- T3 Beam transport and Arc in XS2

!------- July 2023. New layout 


!----- Section and Subsection Markers

STSEC.T3.T3:   MARKER;
ENSEC.T3.T3:   MARKER; 

STSUB.T3U.T3:  MARKER;   ! Start of subsection from start of T3 up to photon beamline start
ENSUB.T3U.T3:  MARKER; 

STSUB.T3T.T3:  MARKER;   ! Start of subsection from photon beamline start to end of T3 section
ENSUB.T3T.T3:  MARKER; 


!----- Diagnostics Marker

BPMA.T3: MONITOR;
BPMAMARK.T3: MARKER;
BPME.T3: MONITOR;
TORA.T3: MARKER;
BAM.T3:  MARKER;
OTRB.T3: MARKER;
OTRC.T3: MARKER;
BAMC.T3: MARKER;


!----- Correctors (L_yoke is used)

CEX.T3:    HKICKER, L=0.1;
CEY.T3:    VKICKER, L=0.1;
CHX.T3:    HKICKER, L=0.2;
CHY.T3:    VKICKER, L=0.2;
CMX.T3:    HKICKER, L=0.3;
CMY.T3:    VKICKER, L=0.3;

!------------------------------------------------------------------------------------------------

!----- FODO cell in T3:  T3LFODO

!--- Setting for mu_x = mu_y = 60 deg
QE.1.T3:  Quadrupole, L = L_QE_eff, K1 = +0.192279551578;
QE.2.T3:  Quadrupole, L = L_QE_eff, K1 = -0.192279551578;

T3LFODO: LINE = (D10000, D0450,                    &
                 QESEC(BPMA.T3, QE.1.T3, CEX.T3),  &
                 D10000, D10000, D0935,            &
                 QESEC(BPMA.T3, QE.2.T3, CEY.T3),  &
                 D10000, D0485);

comment
!--- no T3LFCDO in new layout 
T3LFCDO: LINE = (D10000, D0450,                          &
                 QESEC(BPMA.T3, QE.1.T3, CEX.T3),        &
                 D0300, CMY.12.T3, D9400, D10000, D0935, &  ! additional CMY corrector
                 QESEC(BPMA.T3, QE.2.T3, CEY.T3),        &
                 D10000, D0485)
endcomment

!------------------------------------------------------------------------------------------------


!-------- Matching from SCU to T3M: T3MATCH1

!----- Dechirper

VCCHIRP.T3:   MARKER;
VCCHIRP_S.T3: MARKER;

!--- Description using RBEND to see in the plot
nD1000: RBEND, L = 1.0;
nD0500: RBEND, L = 0.5; 

CHIRP.T3: LINE = (VCCHIRP_S.T3,D1000,VCCHIRP_S.T3,D1000,VCCHIRP_S.T3, &
                  D0500, VCCHIRP.T3, D0500,                           &
                  VCCHIRP_S.T3,D1000,VCCHIRP_S.T3,D1000,VCCHIRP_S.T3);


!--- Correctors for orbit bump

!CMY.1.T3: RBEND, L=0.3, tilt=pi/2;
!CMY.2.T3: RBEND, L=0.3, tilt=pi/2; 
!CMY.3.T3: RBEND, L=0.3, tilt=pi/2;
!CMY.4.T3: RBEND, L=0.3, tilt=pi/2;

CMY.11.T3: VKICKER, L=0.3, KICK = 0.0;
CMY.12.T3: VKICKER, L=0.3, Kick = 0.0;
CMY.3.T3: VKICKER, L=0.3, Kick = 0.0;
CMY.4.T3: VKICKER, L=0.3, KICK = 0.0;

comment
!--- 17.07.2023. deltaY = 4 mm
CMY.1.T3: VKICKER, L=0.3, KICK = +0.377383865204E-3;
CMY.2.T3: VKICKER, L=0.3, Kick = -0.454670075926E-3;
CMY.3.T3: VKICKER, L=0.3, Kick = -0.217491240247E-3;
CMY.4.T3: VKICKER, L=0.3, KICK = +0.341900311503E-3;
endcomment


!--- 09.05.2023. New layout of T3MATCH1: Var 4b, 4xQE quads and QH.3/4.T1 tuned

!--- Drifts here for a while 
D2820:  Drift, L =  2.820;
D09415: Drift, L =  0.9415;
D22415: Drift, L =  2.2415;
D10055: Drift, L = 10.055;
D9660:  Drift, L =  9.660;
D2105:  Drift, L =  2.105;

                   
!----- Quadrupoles

!--- Undulator SASE2 open (default)

!--- Nominal optics, QH.3.T3 and QH.4.T3 tuned (setting below)
QE.3.T3: QUADRUPOLE, L = L_QE_eff, K1 = +0.216958875566;
QE.4.T3: QUADRUPOLE, L = L_QE_eff, K1 = -0.201978926986;
QE.5.T3: QUADRUPOLE, L = L_QE_eff, K1 = +0.247055467418;
QE.6.T3: QUADRUPOLE, L = L_QE_eff, K1 = -0.252027191702;

D1310: DRIFT, L=1.31
D1340: DRIFT, L=1.34
! to Winni: new layout of T3MATCH1

T3MATCH1: Line = (STSUB.T3U.T3,                             &
!                  VCST10T40.T3, D0058, D03325,              &  ! without BAMC
                  VCST10T22.T3, D0258,BAMC.T3,D0042,        &   ! insert BAMC and chamber with 22 mm
                  VCST22T40.T3,D00905,                      &   ! insert BAMC
                  D1340, TORA.T3,                            &
                  D1310,                                    &   ! because SCU got shorter
                  CMY.T3, D0230, CMX.T3, D2820,           &  ! 1st bump cor & new CMX
                  QESEC(BPMA.T3, QE.3.T3, CEX.T3),          &  ! BPM kept
                  D5000, CMY.11.T3, D09415,                  &  ! 2d bump cor 
                  BPMA.T3, D0500, CHIRP.T3, D0500, BPMA.T3, &  ! new BPM & moved BPM 
                  D22415,                                   &
                  D0100, D0100, D0050,                       &  ! no BPM 
                  qeD0075, QE.4.T3, qeD0080,                &
                  D0040, CMY.T3, D0070,                     &  ! 3d bump cor, replace CEY by CMY 
                  D10055,                                   & 
