               QI.24.I1, D011615, D0100, D0165, D01086082,   & 
               BL.7.2.I1, D01349319, SC.2.2.I1,              &
               D00751, QI.23.I1, D00751, SC.1.2.I1,          &
               D00744318046, D00175, CIY.I1, D01325,         &
               BPMA.I1, D0150,                               &
               BL.8.I1, D01823768, QI.25.I1);


!----- Dogleg: Start at the entrance of first quadrupole

DLGCORE: Line = (STLAT.DOG.I1, MATCH.DLG.I1,      & 
                 DLG1A, DLG1B, DLG3A, DLG3BM,     &
                 ENLAT.DOG.I1, ENSUB.I1T.I1);


!----- Total Dogleg section: I1DLG 

I1DLG: Line = (I1DLGU, DLGCORE);


!-----------------------------------------------------------------------------------
!----- Bunch Compressor I1BC0 = (BC0U, BC0CORE, BC0D) ------------------------------
!-----------------------------------------------------------------------------------

COLO.I1:   ECOL, XSIZE=0.02, YSIZE=0.02;   ! collimator in B0
COLU.I1:   ECOL, XSIZE=0.02, YSIZE=0.02;   ! collimator in B0


!----- Section in front of BC0CORE: BC0U  

!--- Quadrupoles

! Setting for design angle_b0 = 6.850878128775468 deg
QI.26.I1: Quadrupole, L = L_QI_eff, K1 = +3.376422450845; 
QI.27.I1: Quadrupole, L = L_QI_eff, K1 = -3.050392292533;

comment
! Setting for angle_BC0 = 7.83 deg -- Bolko email, 03.08.2018
QI.26.I1: Quadrupole, L = L_QI_eff, K1 = +3.345427062071; 
QI.27.I1: Quadrupole, L = L_QI_eff, K1 = -3.013328964062;
endcomment

BC0U: LINE = (D000013, D088115, TORA.I1, D0200, CIY.I1,   &
              D009115, QI.26.I1, D015365,                 &
              D01275, MIDBPMF.I1, D0096, BPMF.I1, D00315, &
              D01725, CIX.I1, D009115, QI.27.I1, D018115, &
              D0200);

!-----------------------------------------------------------------------------------


!----- BC0 chicane: BC0CORE  

!--- BC0 dipoles

!L_BB_yoke = 0.5000;   ! defined in DEFS file
!L_BB_eff  = 0.5582;   ! defined in DEFS file

!--- Model with L_yoke is used

l_b0  = L_BB_yoke;
               
ang_b0 =  0.11957038;            ! 6.850878128775468 deg - design value 
!ang_b0 =  7.83*pi/180;          ! 0.136659280431156 rad - Bolko, 03.08.2018, used

arc_b0 = l_b0/sin(ang_b0)*ang_b0;
               
BB.1.1.I1: SBEND, L = arc_b0, ANGLE = ang_b0, &
           E1 = 0, E2 = ang_b0, TILT = pi/2;
BB.1.2.I1: SBEND, L = arc_b0, ANGLE =-ang_b0, &
           E1 = -ang_b0, E2 = 0, TILT = pi/2;
BB.1.3.I1: SBEND, L = arc_b0, ANGLE =-ang_b0, &
           E1 = 0, E2 =-ang_b0, TILT = pi/2;
BB.1.4.I1: SBEND, L = arc_b0, ANGLE = ang_b0, &
           E1 = ang_b0, E2 = 0, TILT = pi/2;
                 
DELTAL  = 1.0;
CD1000I = DELTAL / cos(ang_b0);

D1000I:  DRIFT, L = CD1000I;
D1000IM: DRIFT, L = CD1000I - 0.6;

BC0CORE: LINE = (STLAT.B0M.I1, D0100,                            &
                 BB.1.1.I1, VCST40T400Y.I1, D1000I, VCST400Y.I1, &
                 BB.1.2.I1,CBB.2.I1,                             &
                 D03975, COLO.I1, D0085, COLU.I1, D03825,        &
                 BPMS.I1, D0310, OTRS.I1, D0325,                 &
                 BB.1.3.I1,CBB.3.I1,                             &
                 VCST400YT40.I1, D0600, D1000IM, VCST40Y.I1,     &
                 BB.1.4.I1,CBB.4.I1,                             &
                 D0100, ENLAT.B0M.I1);   

!-----------------------------------------------------------------------------------


!----- Section behind of BC0 chicane: BC0D  

!--- Quadrupoles

! Setting for design angle_b0 = 6.850878128775468 deg
QI.28.I1: Quadrupole, L = L_QI_eff, K1 = +0.687960942049;
QI.29.I1: Quadrupole, L = L_QI_eff, K1 = -1.359150063327;
QI.30.I1: Quadrupole, L = L_QI_eff, K1 = +1.497501211839;

comment
! Setting for angle_BC0 = 7.83 deg -- Bolko email, 03.08.2018
QI.28.I1: Quadrupole, L = L_QI_eff, K1 = +0.384438675053;
QI.29.I1: Quadrupole, L = L_QI_eff, K1 = -1.068432517039;
QI.30.I1: Quadrupole, L = L_QI_eff, K1 = +1.475998497224;
endcmment

BC0D: LINE = (D0200,                                               &
              D0100, D009115, QI.28.I1, D009115, CIX.I1, D01225,   &
              D01275, MIDBPMF.I1, D0096, BPMF.I1, D00315,          &
              D01125, CIY.I1, D009115, QI.29.I1, D018115, BPMA.I1, &
              D0500, D0060, CIX.I1, D009115, QI.30.I1);


!----- BC0 section: I1BC0

I1BC0: LINE = (STSUB.B0.I1, BC0U, BC0CORE, BC0D);


comment
! Setting for the design angle_BC0 = 6.8509 deg
!--- BC0U: In front of BC0
set, QI.26.I1[k1], +3.376422450845
set, QI.27.I1[k1], -3.050392292533
!--- BC0D: Behind of BC0  
set, QI.28.I1[k1], +0.687960942049
set, QI.29.I1[k1], -1.359150063327
set, QI.30.I1[k1], +1.497501211839
endcomment

!-----------------------------------------------------------------------------------
!----- Phase Shifter: I1PS ---------------------------------------------------------
!-----------------------------------------------------------------------------------


!--- Quadrupoles

QI.31.I1: Quadrupole, L = L_QI_eff, K1 = -1.522641254394;
QI.32.I1: Quadrupole, L = L_QI_eff, K1 = +1.522641067699;


!--- I1PS FODO cell to define the periodic solution

fodo_I1_PS: LINE = (MATCH.PS.I1, D018115, BPMA.I1, D1800, D0090,     &
                    CIY.I1, D009115, QI.31.I1,                       &
                    D018115, BPMA.I1, D1800, D0090, CIX.I1, D009115, &
                    QI.32.I1);


I1PS:  LINE = (STLAT.PS.I1, MATCH.PS.I1,                             &
               D018115, BPMA.I1, D1800, D0090, CIY.I1, D009115,      &
               QI.31.I1,                                             &
               D018115, BPMA.I1, D1800, D0090, CIX.I1, D009115,      &
               QI.32.I1,                                             &
               D018115, BPMA.I1, D1800, D0090, CIY.I1, D009115,      &
               QI.31.I1,                                             & 
               D018115, BPMA.I1, D0500, VCDST.I1, D0325, ENLAT.PS.I1);


!-----------------------------------------------------------------------------------
