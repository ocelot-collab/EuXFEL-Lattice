                  D018115, QI.12.I1, D013115, D0400, ENSUB.I1M.I1);


!----- Section behind of I1D dump dipole: I1DIA2

BB.0.I1: DRIFT, L = 0.5;              ! Placeholder in straight beamline for BB.5.I1D
!BB.0.I1: RBEND, L = 0.5, ANGLE=0;    ! Placeholder in straight beamline for BB.5.I1D

BSECI.I1: RBEND, L=0.4, ANGLE=0;


!--- Quadrupoles

QI.13.I1: Quadrupole, L = L_QI_eff, K1 = -1.824087238688;
QI.14.I1: Quadrupole, L = L_QI_eff, K1 = +2.142575757027;

I1DIAD2: LINE = (STSUB.I1T.I1, BB.0.I1, CBB.5.I1D, D0540, D0200, CIY.I1, & 
                 D008115, QI.13.I1, D013115, BPMA.I1, D0150,  &
                 D0400, BSECI.I1, D0500, CIX.I1, D0150,       &
                 VCBSHUT.I1, D018115, QI.14.I1);     


!----- Total diagnostic section: I1DIA

