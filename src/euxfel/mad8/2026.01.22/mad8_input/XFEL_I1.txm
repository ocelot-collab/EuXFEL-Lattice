!-----------------------------------------------------------------------------------


!--- Quadrupoles

!--- Setting for the energy gain in L1: 130 MeV => 700 MeV
QI.33.I1: Quadrupole, L = L_QI_eff, K1 = +0.996799661408;
QI.34.I1: Quadrupole, L = L_QI_eff, K1 = +0.537541402855;
QI.35.I1: Quadrupole, L = L_QI_eff, K1 = -0.941219919992;

L1U:  LINE = (CIX.I1, D009115, QI.33.I1, D018115, BPMA.I1, &
              D11242, TORA.I1, D01408,                     &
              CIY.I1, D009115, QI.34.I1, D013965, BPMA.I1, &
              D109132, OTRA.I1, D034903, DCM.I1, D009115,  &
              CIX.I1, D009115, QI.35.I1, D014395, BPMA.I1, &
              D03522, ENSUB.B0.I1);


!-----------------------------------------------------------------------------------
!----- Total injector section: I1
!-----------------------------------------------------------------------------------

!--- Start at GUN, Z = 23.2 m

I1:      LINE = (STSEC.I1.I1, I1G1, I1M1, L0, I1LH, I1DIA, &
                 I1DLG, I1BC0, I1PS, L1U, ENSEC.I1.I1);


!--- Start at Z = 37.6484 m, in the front of 1st cold quadrupole Q.A1.1.I1 

I1_L0C8:  LINE = (L0C8, I1LH, I1DIA, I1DLG, I1BC0, I1PS, L1U, ENSEC.I1.I1);

!===================================================================================


!-----------------------------------------------------------------------------------
!
!----- Injector dump beamline: I1D -------------------------------------------------
!
!----- I1DIAD1 section in the front of I1D dipole (two quadrupoles)
!         1) with quadrupole setting like for the straight line:
!            QI.11.I1: Quadrupole, L = L_QI_eff, K1 = +1.977819462285;
!            QI.12.I1: Quadrupole, L = L_QI_eff, K1 = +0.870861987047;
!            only 1-2 bunches are allowed
!         2) for 2 < N_b < 1000 other setting of these quadrupoles has to be used
!
!----- I1D section behind I1D dipole (two quadrupoles)
!        1) with quadrupole setting below
!           QI.41.I1D: Quadrupole, L = L_QI_eff, K1 = +4.401795;
!           QI.42.I1D: Quadrupole, L = L_QI_eff, K1 =  0.0;
!           the dispersion at I1D dump is around zero
!        2) optics solution with D_x = 0 at I1D dump is possible 
!           only for N_b < 1000
!        3) if N_b > 1000 other setting of these two quadrupoles has to be used
!
!-----------------------------------------------------------------------------------

DUFLANGE.I1D:   MARKER;
DUCONCRETE.I1D: MARKER;
DUABSORB.I1D:   MARKER;


!--- Dipole to injector dump I1D

!L_BB_yoke = 0.5000;   ! defined in DEFS file

l_i1d      = L_BB_yoke;
ang_i1d    = 30*PI/180;
ang_i1d_ee = ang_i1d/2;
arc_i1d    = 0.5*l_i1d*ang_i1d/sin(0.5*ang_i1d);

BB.5.I1D: SBEND, L = arc_i1d, ANGLE = ang_i1d,    &
                 E1 = ang_i1d_ee, E2 = ang_i1d_ee;


!--- Quadrupoles in the dump line

!--- Relaxed optics: 
!      Setting of QI.11.I1/QI.12.I1 like for the straight line
!      at I1D dump: beta_x = 26.60m, beta_y = 81.27m, Dx = -0.003 m
!      Number of bunches: N_b = 1-2

QI.41.I1D: Quadrupole, L = L_QI_eff, K1 = +4.401795;
QI.42.I1D: Quadrupole, L = L_QI_eff, K1 =  0.0;


!I1D:   LINE = (STSEC.I1D.I1D, BB.5.I1D, CBB.5.I1D, D0250, D0135,    &
I1D:   LINE = (STSEC.I1D.I1D, BB.5.I1D, D0250, D0135,               &
               D0500, D008115, QI.41.I1D, D015615,                  &
               BPMA.I1D, D0250, D0156, OTRC.I1D, D0150, D000015,    &
               QI.42.I1D, D009915, VCST40T98.I1D, D015006,          &
               OTRD.I1D, D0225, TORC.I1D, D0125, BPMD.I1D, D0050,   &
               VCST98T60.I1D, D023523,                              &
               DUFLANGE.I1D, D0252, DUCONCRETE.I1D, D1696, BHM.I1D, &
               D0098, DUABSORB.I1D, ENSEC.I1D.I1D);                                    

!-----------------------------------------------------------------------------------
!----- Total injector beamline to the dump: I1TI1D
!-----------------------------------------------------------------------------------

!--- Defined in DEFS file, here definitions are for information. 

!--- Start at GUN, Z = 23.2 m
!I1TI1D:      LINE = (STSEC.I1.I1, I1G1, I1M1, L0, I1LH,     &
!                     I1DIAU, I1DIACORE, I1DIAD1, I1D);


!--- Start at Z = 37.6484 m, in the front of 1st cold quadrupole Q.A1.1.I1 
!I1TI1D_L0C8: LINE = (L0C8, I1LH, I1DIAU, I1DIACORE, I1DIAD1, I1D);


!-----------------------------------------------------------------------------------
!--- For back tracking: From entrance of 1st cold quadrupole Q.A1.1.I1 (Z = 37.6484 m)
!                       to GUN.I1 (Z = 23.2 m)
!-----------------------------------------------------------------------------------

BACKTR_ACC1_GUN: LINE = (L0C8REV, -I1M1, -I1G1, STSEC.I1.I1);

!===================================================================================
!===================================================================================

