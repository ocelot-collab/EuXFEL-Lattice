!----- Section in front of I1D dump dipole: I1DIA1  

!--- Quadrupoles

QI.11.I1: Quadrupole, L = L_QI_eff, K1 = +1.977819462285;
QI.12.I1: Quadrupole, L = L_QI_eff, K1 = +0.870861987047;

