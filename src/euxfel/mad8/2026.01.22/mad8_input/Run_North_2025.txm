!---------------------------------------------------------------------------------------
!
!  December 2022: XFEL Lattice and Optics --- NORTH beamline (SA1, SA3)
!
!---------------------------------------------------------------------------------------
!
!  25.01.2022: In the front of SA1: Elements for corrugated structure system
!  09.06.2020: Fitting of TD20 geometry
!  06.01.2020: Review of Afterburner section
!  10.12.2019. SASE3 - undulator segment in CELL2 and chicane in CELL13
!  09.07.2019: New layout for TD20 - two KL kickers behind all TD1 septa
!  08.07.2019. Description of Afterburner undulators U90 is added
!  March 2019: Upgrade of TD20 (layout of 2010 year, 1st septum between TD1 septa)
!  28.02.2019: Coupler kicks in A1 and AH1
!  07.01.2019: SASE2 upgrade - two chicanes in CELL 9 and CELL 18
!
!---------------------------------------------------------------------------------------

!assign,print="print"
option, -echo, -info,warn

!---------------------------------------------------------------------------------------

SETPLOT, FONT=1, LWIDTH=8, POST=2, LSCALE=2.0, SSCALE=2.0, &
         RSCALE=1.6, ASCALE=1.9

!beam, energy=0.150
!beam, particle=electron, energy=0.7, ex=0.01e-6, ey=0.01e-6, sige=1.0e-03

!---------------------------------------------------------------------------------------

!----- GUN.23.I1: Z coordinate 

set, z0_start, 23.2


!----- L0C8, MATCH.FQ.I1: Z coordinate
 
set, z0_L0C8, 37.6484

!---------------------------------------------------------------------------------------


!----- Call files needed for NORTH line

call,"XFEL_DEFS.txm"       ! Definitions

call, "XFEL_I1.txm"
call, "XFEL_L1.txm"
call, "XFEL_B1.txm"
call, "XFEL_L2.txm"
call, "XFEL_B2.txm"
call, "XFEL_L3.txm"
call, "XFEL_CL.txm"
call, "XFEL_TL.txm"
call, "XFEL_North_2025.txm"

!--- call other model setup and optics in sections
!call, "SET_closed_LHund_130MeV_42mm.txm"   ! LH undulator closed
!call, "SET_closed_SA1_14GeV_136_b32.txm"   ! SA1 closed
!call, "SET_closed_SA3_14GeV_110_b15.txm"   ! SA3 closed

!---------------------------------------------------------------------------------------
!---------------------------------------------------------------------------------------

!----- T4D

!----- Initial Twiss functions at Z = 37.6484 m, MATCH.FQ.I1
!      Historical values used as initial Twiss functions
!      for the design of linear beam optics downstream
B0_I1.ACC1:  BETA0, energy= 0.150, &
                    betx = 25.543,  alfx = -0.3771,  &
                    bety = 25.543,  alfy = -0.3771;

!----- Twiss functions at Cathode, GUN.23.I1
!      Calculated by back tracking from MATCH.FQ.I1 to GUN.23.I1
!      Back tracking: TWISS command with COUPLE logical flag
B0_I1.G1:    BETA0, energy= 0.005, &
                    betx = 55.798075,  alfx = 18.18859573,  &
                    bety = 55.798075,  alfy = 18.18859573;


!B0_I1.G1: BETA0, energy= 0.005, &
!                   betx = 55.7963, alfx = 18.1881,   &  
!                   bety = 55.7963, alfy = 18.1881

!---------------------------------------------------------------------------------------

!----- L3 Linac, 01.04.2021
                   
!--- Twiss functions at entrance of L3 Linac: at STSEC.L3.L3
B0_L3.START: BETA0, energy=2.4, &
                    betx =  20.87580019, alfx = +0.6832651040, &
                    bety =  12.34773177, alfy = -0.2933160793

!--- Twiss functions at matching point L3 Linac: at MATCH.L3.L3 (ENAC.A6.4.L3)
B0_L3.MATCH: BETA0, energy= 3.044444, &  
                    betx = 21.95129411, alfx= -0.7217923900, &
                    bety=  45.14539085, alfy= +1.461531462

!----- CL collimation section, 01.04.2021

B0_CLARC.FODOH:   BETA0, energy=17.5, &
                         betx=  5.308640275, alfx= -3.311275545E-05, &
                         bety= 30.511653610, alfy= +9.860208573E-07

B0_CLARC.FODO.EN: BETA0, &
                         betx=  5.436080984, alfx= +0.4824441004, &
                         bety= 29.867817500, alfy= -2.4027535990
B0_CLARC.FODO.EX: BETA0, &
                         betx=  5.436080984, alfx= -0.4824441004, &
                         bety= 29.867817500, alfy= +2.4027535990

B0_CLARC.ModB.EN: BETA0, &
                         betx=  0.5868101677, alfx= +0.7071467036, &
                         bety=  5.884652503,  alfy= -0.4304690251
B0_CLARC.ModB.EX: BETA0, &
                         betx=  0.5868101677, alfx= -0.7071467036, &
                         bety=  5.884652503,  alfy= +0.4304690251

B0_CLARC.ModA.EN: BETA0, &
                         betx=  0.5607322842, alfx= +1.365507289, &
                         bety=  2.959896455,  alfy= -0.1496637068
B0_CLARC.ModA.EX: BETA0, &
                         betx=  0.5607322842, alfx= -1.365507289, &
                         bety=  2.959896455,  alfy= +0.1496637068

!---------------------------------------------------------------------------------------

!----- Setting of TLD beamline elements
!         1) Only setting for KS kickers are needed
!         2) Quadrupoles between KS and 2d septum have
!            individual names and defined in XFEL_Run_TLD.txm


!----- TLD: Setting for KS kickers and quadrupoles between KS and 2d septum 

!--- KS kickers are RBEND with zero angle
set, KSPOS.1.TL[ANGLE],     0
set, KSNEG.1.TL[ANGLE],     0

comment
!--- QF.1.TLD.TL quadrupole is SBEND with zero angle
set, QF.1.TLD.TL[ANGLE],    0
set, QF.1.TLD.TL[E1],       0
set, QF.1.TLD.TL[E2],       0

!--- QF.2.TLD.TL quadrupole is SBEND with zero angle
set, QF.2.TLD.TL[ANGLE],    0
set, QF.2.TLD.TL[E1],       0
set, QF.2.TLD.TL[E2],       0

!--- QK.1.TLD.TL quadrupole is sliced in N slices: Exception
endcomment


!--- Model with HELP elements is still possible

!--- HELP elements are RBEND with zero angle
set, HELP.1a.TLD[ANGLE], 0
set, HELP.1b.TLD[ANGLE], 0
set, HELP.2a.TLD[ANGLE], 0
set, HELP.2b.TLD[ANGLE], 0
set, HELP.3a.TLD[ANGLE], 0
set, HELP.3b.TLD[ANGLE], 0

!---------------------------------------------------------------------------------------

!----- Setting of T5D beamline elements
!         1) Only setting for KL kickers are needed
!         2) Quadrupoles between KL and 2d septum have
!            individual names and defined in XFEL_Run_South.txm


!----- T5D: Setting for KL kickers and quadrupoles between KL and 2d septum

!--- KL kickers are RBEND with zero angle
set, KL.1.TL[ANGLE],  0
set, KL.2.TL[ANGLE],  0

comment
!--- QF.1.T1.TL quadrupole is SBEND with zero angle
set, QF.1.T1.TL[ANGLE],    0
set, QF.1.T1.TL[E1],       0
set, QF.1.T1.TL[E2],       0

!--- QK.2.T1.TL quadrupole is sliced in N slices: Exception
endcomment


!--- Model with HELP elements is still possible

!--- HELP elements are RBEND with zero angle
set, HELP.1a.T1[ANGLE], 0
set, HELP.1b.T1[ANGLE], 0
set, HELP.2a.T1[ANGLE], 0
set, HELP.2b.T1[ANGLE], 0

!---------------------------------------------------------------------------------------


!----- Setting of T20 beamline elements
!         1) Only setting for KL.T20 kickers are needed
!         2) Quadrupoles between KL.T20 and 2d septum have
!            individual names and defined in XFEL_Run_T20.txm


!----- TD20: Setting for KL kickers and quadrupoles between KL and 2d septum

!--- KL kickers are RBEND with zero angle
set, KL.20.TL[ANGLE],   0 

comment
!--- QF.1.T20.TL quadrupole is SBEND with zero angle
set, QF.1.T20.TL[ANGLE],    0
set, QF.1.T20.TL[E1],       0
set, QF.1.T20.TL[E2],       0

!--- QK.2.T20.TL quadrupole is splitted in N slices: Exception
endcomment


!--- Model with HELP elements is still possible

!--- HELP elements are RBEND with zero angle
set, HELP.1a.T20[ANGLE], 0
set, HELP.1b.T20[ANGLE], 0
set, HELP.2a.T20[ANGLE], 0
set, HELP.2b.T20[ANGLE], 0

!---------------------------------------------------------------------------------------
!---------------------------------------------------------------------------------------

!----- Start at cathode

title, "XFEL G1 to T4D: November 2022"
beam, energy=0.005
use, I1TT4D
print, #s/#e
!twiss, beta0=B0_I1.G1, save, couple, tape=twiss_tmp
twiss, beta0=B0_I1.G1, save, tape=twiss_T4D
plot,table=twiss,haxis=s, vaxis1=betx,bety, spline,colour=100, &
     vmin=0,vmax=500, vaxis2=dx,dy

! T2B section
plot,table=twiss,haxis=s, vaxis1=betx,bety, spline,colour=100, &
     vmin=0,vmax=200, hmin=2050, hmax=2450

!static, map

survey, y0=-2.75, z0 = z0_start, tape=survey_T4D

!---------------------------------------------------------------------------------------


comment
!----- Start at MATCH.FQ.I1

title, "XFEL G1 to T4D: November 2022"
beam, energy=0.150
use, I1TT4D_L0C8
print, #s/#e
!twiss, beta0=B0_I1.ACC1, save, couple, tape=twiss_T4D_L0C8
twiss, beta0=B0_I1.ACC1, save, tape=twiss_T4D_L0C8
plot, table=twiss,haxis=s, vaxis1=betx,bety, spline,colour=100, &
      vmin=0,vmax=500, hmin=0,hmax=3000
plot, table=twiss,haxis=s, vaxis1=dx,dy, spline,colour=100, &
      vmin=-0.2,vmax=+0.2, hmin=0,hmax=3000

plot, table=twiss,haxis=s, vaxis1=dx,dy, spline,colour=100, &
      vmin=-0.2,vmax=+0.3, hmin=0,hmax=70

!static, map

survey, y0 = -2.75, z0 = z0_L0C8, tape=survey_T4D_L0C8
endcomment

!---------------------------------------------------------------------------------------

!call,"Matching_B1.txm"
!call,"Matching_COLL.txm"  
!call,"Matching_UND.txm"   
!call,"Matching_TD2.txm"   

!---------------------------------------------------------------------------------------

!comment

title, "XFEL G1 to T9"
beam, energy=0.005
use, I1TT9
!call, "MAGNET_SET_G1toT4D.txm"
twiss, beta0=B0_I1.G1, save, tape=twiss_T9 
!setTD1lay
survey, y0=-2.75, z0 = z0_start, &
        tape=survey_t9

title, "XFEL G1 to T10"
beam, energy=0.005
use, I1TT10
!call, "MAGNET_SET_G1toT4D.txm"
twiss, beta0=B0_I1.G1, save, tape=twiss_T10 
!setTD1lay
survey, y0=-2.75, z0 = z0_start, &
        tape=survey_t10

!endcomment

!---------------------------------------------------------------------------------------
!---------------------------------------------------------------------------------------

