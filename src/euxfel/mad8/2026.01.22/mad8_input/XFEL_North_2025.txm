!================================================================================================
!
!--- November 2022, XFEL lattice --- North beamline starting from T2 section
!
!================================================================================================
!
!  Beam Line NORTH: SASE1, XS3, SASE3
!
!  NORTH: LINE = (T2, SA1, T4, SA3_UE90, T4D)
!
!================================================================================================
!
!  January 2022:   In the front of SA1: Corrugated structure, two new quadrupoles, kickers, collimator
!  July    2019:   Afterburner section behind SASE3 is added
!  July    2019:   T20 is added
!
!================================================================================================

comment
!----- Section and Subsection Markers

STSEC.TLD.TLD: MARKER;  ! used in this file
ENSEC.TLD.TLD: MARKER;  ! used in TLD file

STSEC.T1.T1:  MARKER;   ! used in this file
