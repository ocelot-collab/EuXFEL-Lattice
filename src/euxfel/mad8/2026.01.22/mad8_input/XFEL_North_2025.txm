STSEC.T20.T20: MARKER;  ! used in this file 
ENSEC.T20.T20: MARKER;  ! used in T20 file 
endcomment


!----- Vacuum Markers and Vacuum Components 

VCST40T10.T2:   MARKER;
VCST40T18.T2:   MARKER;
VCST18T40.T2:   MARKER;
VCST10T40.T4:   MARKER;
VCST40T10.T4:   MARKER;
VCST10T40.T4D:  MARKER;
VCST93YT40.T4D: MARKER;
VCST98T98Y.T4D: MARKER;
VCST98YT98.T4D: MARKER;
VCST40T93Y.T4D: MARKER;
VCST40T98.T4D:  MARKER;
VCST98T200.T4D: MARKER;
VCST10T22.T4D:  MARKER;
VCST22T40.T4D:  MARKER;

VCMIR.T2: MARKER

!************************************************************************************************
!
!---------- T2 Line: (T2A, T2B)
!
!************************************************************************************************

!----- Section and Subsection Markers

STSEC.T2.T2: MARKER;
ENSEC.T2.T2: MARKER;
STSUB.T2U.T2: MARKER;
ENSUB.T2U.T2: MARKER;
STSUB.T2M.T2: MARKER;
ENSUB.T2M.T2: MARKER;

!----- Diagnostic Markers

BPMA.T2:  MONITOR;
BPME.T2:  MONITOR;
OTRBW.T2: MARKER;
OTRB.T2:  MARKER;
OTRC.T2:  MARKER;
SPEC.T2: MARKER;
OTRCMARK.T2:  MARKER;
SPECMARK.T2: MARKER;
TORA.T2:  MARKER;
BCM.T2:   MARKER;

!----- Vacuum Markers and Vacuum Components

VCBSHUT.T2: DRIFT, L=0.3;
VCBSTOP.T2: DRIFT, L=0.3;


!----- Correctors (L_yoke is used)

CEX.T2: HKICKER, L = 0.100;
CEY.T2: VKICKER, L = 0.100;
CFX.T2: HKICKER, L = 0.100;
CFY.T2: VKICKER, L = 0.100;
CMX.T2: HKICKER, L = 0.300;
CMY.T2: VKICKER, L = 0.300;
CNY.T2: VKICKER, L = 0.300;


BD.10.T2: RBEND, L=1.0, ANGLE=0;
BSECT.T2: RBEND, L=1.5, ANGLE=0;
ABSP.T2:  DRIFT, L=0.05;

!------------------------------------------------------------------------------------------------


!-------- 30 m FODO lattice: T2A 

!----- Quadrupoles

!--- KFscale is defined in TL file

QF.1.1.T2:  Quadrupole, L = L_QF_eff, K1 = +KFscale;
QF.1.2.T2:  Quadrupole, L = L_QF_eff, K1 = -KFscale;

QF.2.1.T2:  Quadrupole, L = L_QF_eff, K1 = +KFscale;
QF.2.2.T2:  Quadrupole, L = L_QF_eff, K1 = -KFscale;


!--- July 2019, with 3 T20 septa (BZ3T20)

T2A: Line = (BZ3T20, D0500, BZ3T20, D0500, BZ3T20, D9425,        &
             D0100,BPMA.T2,D0100, fD0125, QF.1.1.T2, fD0125,     &
             D0045, CFX.T2, D6405, BD.10.T2, D6500,       &
!             D0045, CFX.T2, D6405, D0150, BD.10.T2, D6350,       &   !2025 if T20 will be installed
             D0100,BPMA.T2,D0100, fD0125, QF.1.2.T2, fD0125,     &
             D0045, CFY.T2, D13905,                              &
             D0100,BPMA.T2,D0100, fD0125, QF.1.1.T2, fD0125,     &
             D0045, CFX.T2, D0300, BSECT.T2, D0400, D11705,      &
             D00001, D0100,BPMA.T2,D0100, fD0125);

!------------------------------------------------------------------------------------------------


!-------- Matching section from FODO lattice to SASE1: T2B

!----- First QF.1.T2 is shifted upstream for 0.5m (08.02.2012) 
!----- (from standard position in FODO lattice)


!----- Diagnostic undulator with natural focusing

!--- 3 pairs of poles
!    Period  = 40 mm
!    Gap = 12 mm  =>  B_0 = 0.96 T, K = 3.2784
   
LundS     = 0.040;
NundS     = 3;            ! 0.34 = 3*0.04+0.11+0.11
LundS_3 = LundS * NundS;  ! L = 0.120
   
KundS    = 3.2784;
kQundS   = (2*pi*KundS)/(LundS*gammaUnd*betaUnd);
OmegaS   = kQundS / sqrt(2);
   
!--- Initial beta_y:
r11_udia = cos(OmegaS*LundS);
r12_udia = sin(OmegaS*LundS) / OmegaS;
Beta0_udia = r12_udia / sqrt(1.0 - r11_udia * r11_udia);
!value, beta0_udia;

U40S.T2: MATRIX, L = LundS_3,            &
   RM(1,1) = 1.0,                        &
   RM(1,2) = LundS_3,                    &
   RM(1,3) = 0.0,                        &
   RM(2,2) = 1.0,                        &
   RM(3,3) = cos(OmegaS*LundS_3),        &
   RM(3,4) = sin(OmegaS*LundS_3)/OmegaS, &
   RM(4,3) =-sin(OmegaS*LundS_3)*OmegaS, &
   RM(4,4) = cos(OmegaS*LundS_3);

!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++=

comment
!-------- Section T2B without dechirper and other related elements

!----- Quadrupoles

!--- Setting: Undulator SASE1 open (default)
QF.3.T2:  Quadrupole, L = L_QF_eff, K1 = -0.155080318226;
QF.4.T2:  Quadrupole, L = L_QF_eff, K1 = +0.152454154852;
QF.5.T2:  Quadrupole, L = L_QF_eff, K1 = -0.128671683097;
QF.6.T2:  Quadrupole, L = L_QF_eff, K1 = +0.120612721647;

QA.1.T2:  Quadrupole, L = L_QA_eff, K1 = -0.562055063894;   ! = QA.1.SA1
QA.2.T2:  Quadrupole, L = L_QA_eff, K1 = +0.562055063894;   ! = QA.2.SA1

!----- Quadrupole movers
CMVQA.T2: KICKER, L=0;

T2B: Line = (QF.1.2.T2, fD0125, D0045, CFY.T2, D122482,        &
             VCBSHUT.T2, D01568, D1900,                        &
             QFSEC(BPMA.T2, QF.1.1.T2, CFX.T2), D11165, D0800, &
             QFSEC(BPMA.T2, QF.2.2.T2, CFY.T2), D15065,        &
             QFSEC(BPMA.T2, QF.2.1.T2, CFX.T2), D6740,         &
             D0200, OTRB.T2, D0400, D6525,                     &   ! 1st screen
             QFSEC(BPMA.T2, QF.3.T2,   CFY.T2), D6740,         &
             D0200,          D0400, D6525,                     &
             QFSEC(BPMA.T2, QF.4.T2,   CFX.T2), D6740,         &
             D0200, OTRB.T2, D0400, D6525,                     &   ! 2d  screen
             QFSEC(BPMA.T2, QF.5.T2,   CFY.T2), D5140,         &
             D0200, OTRBW.T2, D0400, D4925,                    &   ! 3d  screen
             QFSEC(BPMA.T2, QF.6.T2,   CFX.T2),                &
             D0200, D3626817, BPMA.T2,                         &   !!! insert for BPM and beam stop in front of SASE1
             D0615, VCBSHUT.T2, D3950733,                      &   !!!
             D0300, TORA.T2, D000675, D0500,                   &  
             D0100, VCST40T10.T2, D009975,                     &  
             D0100, BPME.T2, D0100, aD0125,                    &  
             QA.1.T2, CMVQA.T2, aD0125, D0035, D0025, CNY.T2, D0125,     &  
             CEX.T2, D20575, D0110, U40S.T2, D0110,            &
             D17167, CNY.T2, D0150, CEX.T2, D0160, D0050,      &
             ABSP.T2, D01723, BPME.T2, aD01935, QA.2.T2, CMVQA.T2, aD0047);
endcomment

!++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++=

!-------- November 2022. T2B with dechirper, two additional quadrupoles, kickers, collimator  


!----- Corrugated structure (L = 6 m)

VCCHIRP.T2:   MARKER;
VCCHIRP_S.T2: MARKER;
CHIRP.T2: LINE = (VCCHIRP_S.T2, D1000, VCCHIRP_S.T2, D1000,   &
                  VCCHIRP_S.T2, D1000, VCCHIRP.T2 ,  D1000,   &
                  VCCHIRP_S.T2, D1000, VCCHIRP_S.T2, D1000,   &
                  VCCHIRP_S.T2);

                          
!----- KL kickers
KL.1.T2: RBEND, L = LEN_KL, ANGLE = 0;   ! KL.2144.T2
KL.2.T2: RBEND, L = LEN_KL, ANGLE = 0;   ! KL.2192.T2
KL.3.T2: RBEND, L = LEN_KL, ANGLE = 0;   ! KL.2207.T2   


!----- New collimator              
COLM4.T2: ECOLLIMATOR, L = 0.5, XSIZE = 0.002, YSIZE = 0.002;


!----- Quadrupoles (two new QH & QF quads)

!--- Setting: Design optics for beam transport 

QF.7.T2:  Quadrupole, L = L_QF_eff, K1 = -0.17919084758504;    ! QF.1.2.T2
QF.8.T2:  Quadrupole, L = L_QF_eff, K1 = +0.17919084758504;    ! QF.1.1.T2, bipolar
QH.9.T2:  Quadrupole, L = L_QH_eff, K1 = +0.0;                 ! new, unipolar
QF.9.T2:  Quadrupole, L = L_QF_eff, K1 = +0.0;                 ! replaces QH.9.T2
QF.10.T2: Quadrupole, L = L_QF_eff, K1 = -0.17919084758504;    ! QF.2.2.T2, unipolar
QF.11.T2: Quadrupole, L = L_QF_eff, K1 = +0.17919084758504;    ! QF.2.1.T2, unipolar
!--- dechirper is here
QF.3.T2:  Quadrupole, L = L_QF_eff, K1 = -0.155080318226;
QF.12.T2: Quadrupole, L = L_QF_eff, K1 = +0.0;                 ! new, unipolar
QF.4.T2:  Quadrupole, L = L_QF_eff, K1 = +0.152454154852;
QF.5.T2:  Quadrupole, L = L_QF_eff, K1 = -0.128671683097;
QF.6.T2:  Quadrupole, L = L_QF_eff, K1 = +0.120612721647;

QA.1.T2:  Quadrupole, L = L_QA_eff, K1 = -0.562055063894;   ! = QA.1.SA1
QA.2.T2:  Quadrupole, L = L_QA_eff, K1 = +0.562055063894;   ! = QA.2.SA1

!----- Quadrupole movers
CMVQA.T2: KICKER, L=0;

!------ January 2023: Wiggler (L=4.74 m)

CBP.1.T2: HKICKER, L=0.0;
CBP.2.T2: HKICKER, L=0.0;
CBP.3.T2: HKICKER, L=0.0;
CBP.4.T2: HKICKER, L=0.0;
CBP.5.T2: HKICKER, L=0.0;
CBP.6.T2: HKICKER, L=0.0;
CBP.7.T2: HKICKER, L=0.0;

!--- Dipoles
LEN_BP = 0.44;    

!--- 2023 configuration
comment
ang_wig = -0.000001;
arc_wig = LEN_BP;    ! /sin(ang_wig)*ang_wig
arce_wig = LEN_BP;    ! /sin(ang_wig/2)*ang_wig/2

BP.1.1.T2  : SBEND, L = arce_wig, ANGLE =  ang_wig/2, &
             E1 = 0, E2 = ang_wig/2, TILT = 0;
BP.1.2.T2  : SBEND, L = arce_wig, ANGLE =  ang_wig/2, &
             E1 = -ang_wig/2, E2 = 0, TILT = 0;
BP.2.1.T2: SBEND, L = arc_wig, ANGLE =  -ang_wig,   &
             E1 = -ang_wig/2, E2 = ang_wig/2, TILT = 0;
BP.2.2.T2: SBEND, L = arc_wig, ANGLE = +ang_wig,    &
             E1 = ang_wig/2, E2 = -ang_wig/2, TILT = 0;

deltawig  = 0.210;    ! 0.394
drifwig:  DRIFT, L = deltawig / cos(ang_wig/2);

WIGGLER: LINE=(VCST40T18.T2, D0200, BP.1.1.T2, CBP.1.T2,  &
               drifwig, BP.2.1.T2, drifwig, BP.2.2.T2, drifwig, BP.2.1.T2, &
               drifwig, BP.2.2.T2, drifwig, BP.2.1.T2, drifwig, &
               BP.1.2.T2, CBP.7.T2, D0200, VCST18T40.T2) 
endcomment
