T2B: Line = (QF.7.T2, fD0125, D0045, CFY.T2, D122482,          &
             VCBSHUT.T2,                                       &
             ENSUB.T2U.T2, STSUB.T2M.T2,                       &
             D01568, D1900,                                    &
             QFSEC(BPMA.T2, QF.8.T2, CFX.T2),                  &
!             D549795, QH.9.T2, D0153944, CMX.T2, D2297556,     &
             D549795, D02485, QF.9.T2, D02485, D0153944, CMX.T2, D2297556, &  !2025 replace QH with QF
             KL.1.T2, D045645, D0500, D0800,                   &   ! 1st kicker KL
             QFSEC(BPMA.T2, QF.10.T2, CFY.T2),                 &
             D15065,                                          &
             QFSEC(BPMA.T2, QF.11.T2, CFX.T2),                 &
             D0113946, CMY.T2, D0170496,                       &
             CHIRP.T2, D0155558,                               &   ! corrugated structure 6 m
             D0350, OTRB.T2, D0250, D6525,                     &   ! 1st screen
             QFSEC(BPMA.T2, QF.3.T2, CFY.T2),                  &
!==========================================================================================================
!             D03675, CMX.T2, D102895, D5000,                   & 
!             QF.12.T2, D0138947, D0300, D0204603, D59929,      &
!             QFSEC(BPMA.T2, QF.4.T2, CFX.T2),                  &
!             D03675, CMX.T2, D102895, D2000, VCMIR.T2, D3000,  &  !2025 Variant1: Holey Mirror
!             QF.12.T2, D0138947, D0300, D0204603, D59929,      &  !2025 Variant1: Holey Mirror
!             QFSEC(BPMA.T2, QF.4.T2, CFX.T2),                  &  !2025 Variant1: Holey Mirror
             D03675, CMX.T2, D102895, D3000,                   &  !2025 Variant2: Incoupling Chicane
             QF.12.T2, D08182, D1000, CHIC.T2A, D1000, D08182, &  !2025 Variant2: Incoupling Chicane
             QFSEC(BPMA.T2, QF.4.T2, CFX.T2),                  &  !2025 Variant2: Incoupling Chicane
!===========================================================================================================
             D0113948, CMY.T2,                                 &
             D015395, D0100, KL.2.T2,                          &   ! 2d  kicker KL
             D5142102a, D0200, OTRC.T2, D0400, D04302,         &   !2025 2d  screen
             WIGGLER, D1500, D0200, OTRB.T2, D0400,            &   ! wiggler and YAG
             D0200, D0400, D6525a,                             &   ! Spectrometer
             QFSEC(BPMA.T2, QF.5.T2, CFY.T2),                  &   ! 2d  kicker KL
             D0113949, D0100, KL.3.T2,                         &   
!             D2012251, COLM4.T2,                               & 
!             D14838, D0200, OTRBW.T2, D0400, D4925,            &   ! 3d  screen
             D1012251, COLM4.T2,                               &   !2025 eSASE Chicane
             D05403, OTRBW.T2, D01685, D0400, CHIC.T2B, D0400, &   !2025 eSASE Chicane
             QFSEC(BPMA.T2, QF.6.T2,   CFX.T2),                &
             D0200, D0150, SPEC.T2, D3476817, BPMA.T2,         &   !2025 Spectrometer
             D0615, VCBSHUT.T2, D3950733,                      &   
             D0300, TORA.T2, D000675, D0500,                   &  
             D0100, VCST40T10.T2, D009975,                     &  
             D0100, BPME.T2, D0100, aD0125,                    &  
             QA.1.T2, CMVQA.T2, aD0125, D0035, D0025, CNY.T2, D0125,     &  
             CEX.T2, D20575, D0110, U40S.T2, D0110,            &
             D17167, CNY.T2, D0150, CEX.T2, D0160, D0050,      &
             ABSP.T2, D01723, BPME.T2, aD01935, QA.2.T2, CMVQA.T2, aD0047);

!             QFSEC(BPMA.T2, QF.3.T2, CFY.T2), D669645,         &
!             QF.12.T2, D0138947, CMX.T2, D0204603, D59929,     &


!************************************************************************************************

T2: Line = (STSEC.T2.T2, STSUB.T2U.T2, T2A, T2B, ENSUB.T2M.T2, ENSEC.T2.T2);

!************************************************************************************************
!
!---------- SASE1 - XTD2 35
!---------- SASE1 Undulator (37 cells)
!---------- October  2016: 2 first cells CELL 1 and CELL 2 are without undulator segments)
!---------- November 2021: Undulator segment from CELL33 moved to CELL2
!
!************************************************************************************************


!----- Section and Subsection Markers
STSEC.SA1.SA1: MARKER;
ENSEC.SA1.SA1: MARKER;
STUCELL.SA1:   MARKER;
ENUCELL.SA1:   MARKER;
 
!----- Matching Markers
MATCH.UND.SA1: Marker;

!----- Steerers
CAX.SA1: HKICKER, L=0.025;
CAY.SA1: VKICKER, L=0.025;
CBX.SA1: HKICKER, L=0.025;
CBY.SA1: VKICKER, L=0.025;
CUX.SA1: HKICKER, L=0.000;


!----- Quadrupole movers
CMVQA.SA1: KICKER, L=0;

!----- MONITOR
BPME.SA1: MONITOR;

!----- PHASESHIFTER
BPS.SA1: DRIFT, L=0.23;

!----- ABSORBER
ABSP.SA1: DRIFT, L=0.05;

!------------------------------------------------------------------------------------------------


!----- Model for magnetic field of undulator (natural focusing)

!--- Undulator closed (with natural focusing)
!    - model for U40.SA1 has to be set in SET_MODEL_SA1.txm
!    - matching has to be done to periodic solution in SA1
!    - one example: call, "SET_SA1_closed_14GeV_136_b32.txm"


!--- Undulator open (no natural focusing)

U40.SA1: Drift, L = 5.0;


!--- Definition of undulator segment: Open (default)

UNDU.SA1: Line = (U40.SA1);

!------------------------------------------------------------------------------------------------


!----- Quadrupoles

!--- Setting of quadrupoles depends on energy, undulator gap, betatron functions

!--- Undulator SASE1 open (default), mean beta-function 32 m

QA.1.SA1: Quadrupole, L = L_QA_eff, K1 = -0.562055063894;
QA.2.SA1: Quadrupole, L = L_QA_eff, K1 = +0.562055063894;

!------------------------------------------------------------------------------------------------


!-------- SA1 Lattice

!----- Description of CELL (undulator segments and intersecton): in DEFS file

comment   ! here for info 
!--- New Section Definition Necessary to correctly handle start/end markers
UNDSEC(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,PHS,END): LINE = &
    (START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,             &
     D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047,              &
     D0058, PHS, D000472, END);

!--- Last Undulator Cell ends before the phase shifter
UNDSECE(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,END): LINE =    &
    (START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,             &
     D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047, END);
endcomment

commnent
!--- Old definition
UNDSEC(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,PHS,END): LINE =   &
   (D0058, PHS, D000472, END,                                          &
    START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,                &
    D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047);
endcomment

!------------------------------------------------------------------------------------------------


!----- Undulator chicane

!LEN_BS  = 0.3;      ! defined in DEFS file

BS: SBEND, L = LEN_BS, ANGLE = 0, &   
           E1 = 0, E2 = 0, TILT = 0;

D01485: DRIFT, L = 0.1485;
D12375: DRIFT, L = 1.2375;
D0435:  DRIFT, L = 0.4350;
D0290:  DRIFT, L = 0.2900;
D01515: DRIFT, L = 0.1515;

SEEDCHIC(BS.1,CBS.1,BS.2,CBS.2,BS.3,CBS.3,BS.4,CBS.4,D12375,BPM,MONO): &
           LINE = (D01485,                         &
           BS.1,CBS.1, D12375, BS.2,CBS.2,         &
           D0290, BPM, D0300, MONO, D0435,         &
           BS.3,CBS.3, D12375, BS.4,CBS.4, D01515);

D1025: DRIFT, L = 1.025;
D050157:  DRIFT, L = 0.50157;
D094843:  DRIFT, L = 0.94843 - 0.415;
D0155: DRIFT, L = 0.155;

RRMCHIC(BS.1,CBS.1,BS.2,CBS.2,BS.3,CBS.3,BS.4,CBS.4,D1025, MONO): &
           LINE = (D0145,                         &
           BS.1,CBS.1, D1025, BS.2,CBS.2,         &
           D050157, MONO, D094843,  &
           BS.3,CBS.3, D1025, BS.4,CBS.4, D0155);


!------------------------------------------------------------------------------------------------


!----- Description of CELL (undulator segments and intersecton) without undulators segments

!--- Undulator segment: 5 m long drift
!UNDULATOR: DRIFT, L = 5.0;
!U00.SA1: UNDULATOR;

!--- Undulator segment is devided in two parts
!    for checking of SASE1_Ursprung (deltaZ=2.8905m)
U00.SA1: Marker;
U00Line.SA1: Line = (D2500, U00.SA1, D2500);


!--- Cells without undulator segment

SA1DRIF1: LINE = &
  (UNDSEC(STUCELL.SA1, D0025,D0025, U00Line.SA1, D0025,D0025, CUX.SA1, &
          ABSP.SA1, BPME.SA1, &
          QA.1.SA1, CMVQA.SA1, D0230, ENUCELL.SA1));

SA1DRIF2: LINE = &
  (UNDSEC(STUCELL.SA1, D0025,D0025, U00Line.SA1, D0025,D0025, CUX.SA1, &
          ABSP.SA1, BPME.SA1, &
          QA.2.SA1, CMVQA.SA1, D0230, ENUCELL.SA1));

!--- New description: Periodic solutions at the entrance of CAX.SA1
dofo_SA1_open:  Line = (SA1DRIF1, SA1DRIF2);   ! first quad defocusing
fodo_SA1_open:  Line = (SA1DRIF2, SA1DRIF1);   ! first quad   focusing

!------------------------------------------------------------------------------------------------

!----- Cells with Self-Seeding chicanes

MONO1.SA1: Marker

MCBS.1.SA1: MARKER;
CBS.2.SA1: HKICKER, L=0.0;
CBS.3.SA1: HKICKER, L=0.0;
CBS.4.SA1: HKICKER, L=0.0;

ang_chic1 =  0.000;
arc_chic1 = LEN_BS;       ! /sin(ang_chic1)*ang_chic1

BS.1.1.SA1: SBEND, L = arc_chic1, ANGLE = ang_chic1, &
                   E1 = 0, E2 = ang_chic1, TILT = 0;
BS.1.2.SA1: SBEND, L = arc_chic1, ANGLE =-ang_chic1, &
                   E1 = -ang_chic1, E2 = 0, TILT = 0;
BS.1.3.SA1: SBEND, L = arc_chic1, ANGLE =-ang_chic1, &
                   E1 = 0, E2 =-ang_chic1, TILT = 0;
BS.1.4.SA1: SBEND, L = arc_chic1, ANGLE = ang_chic1, &
                   E1 = ang_chic1, E2 = 0, TILT = 0;

deltachic  = 1.2375;
CD12375I1 = 1.2375 / cos(ang_chic1);
D12375I1:  DRIFT, L = CD12375I1;

CHIC.1.SA1: LINE = &
  (SEEDCHIC(BS.1.1.SA1,MCBS.1.SA1, BS.1.2.SA1,CBS.2.SA1, &
            BS.1.3.SA1,CBS.3.SA1,  BS.1.4.SA1,CBS.4.SA1, &
            D12375I1, D0000, MONO1.SA1));

!----   XFELO chicane

RRM1.SA1: MARKER;
MIRR1.SA1: MARKER;
OTRO.SA1: MARKER;

RRM: LINE = (RRM1.SA1, D0305, MIRR1.SA1, D0110, OTRO.SA1);

RRM2.T4: MARKER;  
MIRR2.T4: MARKER  

MCBS.5.SA1: MARKER;
CBS.6.SA1: HKICKER, L=0.0;
CBS.7.SA1: HKICKER, L=0.0;
CBS.8.SA1: HKICKER, L=0.0;

ang_chic2 =  0.000;
arc_chic2 = LEN_BS;       ! /sin(ang_chic2)*ang_chic2

BS.2.1.SA1: SBEND, L = arc_chic2, ANGLE = ang_chic2, &
                   E1 = 0, E2 = ang_chic2, TILT = 0;
BS.2.2.SA1: SBEND, L = arc_chic2, ANGLE =-ang_chic2, &
                   E1 = -ang_chic2, E2 = 0, TILT = 0;
BS.2.3.SA1: SBEND, L = arc_chic2, ANGLE =-ang_chic2, &
                   E1 = 0, E2 =-ang_chic2, TILT = 0;
BS.2.4.SA1: SBEND, L = arc_chic2, ANGLE = ang_chic2, &
                   E1 = ang_chic2, E2 = 0, TILT = 0;

comment
chickick = 0.003;
BS.1.1.SA1: HKICKER, L = arc_chic2, KICK =  chickick;
BS.1.2.SA1: HKICKER, L = arc_chic2, KICK = -chickick;
BS.1.3.SA1: HKICKER, L = arc_chic2, KICK = -chickick;
BS.1.4.SA1: HKICKER, L = arc_chic2, KICK =  chickick;
endcomment

deltachic  = 1.025;
CD1025I2 = 1.025 / cos(ang_chic2);
D1025I2:  DRIFT, L = CD1025I2;

CHIC.2.SA1: LINE = &
  (RRMCHIC(BS.2.1.SA1,MCBS.5.SA1, BS.2.2.SA1,CBS.6.SA1, &
            BS.2.3.SA1,CBS.7.SA1,  BS.2.4.SA1,CBS.8.SA1, &
            D1025I2, RRM));           

!2023 --- Cell with chicane
SA1SECSEED1: LINE = &
  (UNDSEC(STUCELL.SA1, D0025,D0025,CHIC.1.SA1,D0025,D0025,D0000, &
          ABSP.SA1, BPME.SA1, QA.1.SA1, CMVQA.SA1, BPS.SA1, ENUCELL.SA1));

SA1SECSEED2: LINE = &
  (UNDSEC(STUCELL.SA1, D0025,D0025,CHIC.2.SA1,D0025,D0025,D0000, &
          ABSP.SA1, BPME.SA1, QA.1.SA1, CMVQA.SA1, BPS.SA1, ENUCELL.SA1));

!--- Cell with chicane = drift
!SA1SECSEED1: LINE = &
!  (UNDSEC(STUCELL.SA1, D0025,D0025,D5000,D0025,D0025,D0000, &
!          ABSP.SA1, BPME.SA1, QA.1.SA1, CMVQA.SA1, BPS.SA1, ENUCELL.SA1));           

!------------------------------------------------------------------------------------------------


!--- Sections with undulator segments

!--- Cell with defocusing (horizontal) quadrupole 
SA1SEC1: LINE = &
  (UNDSEC(STUCELL.SA1, CAX.SA1, CAY.SA1, UNDU.SA1,   &
          CBX.SA1, CBY.SA1, CUX.SA1,                 &
          ABSP.SA1, BPME.SA1,                        &
          QA.1.SA1, CMVQA.SA1, BPS.SA1, ENUCELL.SA1));

!--- Last Undulator cell ends before the phase shifter (L = 5.80728 m)
SA1SEC1E: LINE = &
  (UNDSECE(STUCELL.SA1, CAX.SA1, CAY.SA1, UNDU.SA1,  &
           CBX.SA1, CBY.SA1, CUX.SA1,                &
           ABSP.SA1, BPME.SA1,                       &
           QA.1.SA1, CMVQA.SA1, ENUCELL.SA1));

!--- Cell with focusing (horizontal) quadrupole 
SA1SEC2: LINE = &
  (UNDSEC(STUCELL.SA1, CAX.SA1, CAY.SA1, UNDU.SA1,   &
          CBX.SA1, CBY.SA1, CUX.SA1,                 &
          ABSP.SA1, BPME.SA1,                        &
          QA.2.SA1, CMVQA.SA1, BPS.SA1, ENUCELL.SA1));

!--- Cell in the front of chicane without phase shifter BPS.SA1 => D0230
SA1SEC2A: LINE = &
  (UNDSEC(STUCELL.SA1, CAX.SA1, CAY.SA1, UNDU.SA1,   &
          CBX.SA1, CBY.SA1, CUX.SA1,                 &
          ABSP.SA1, BPME.SA1,                        &
          QA.2.SA1, CMVQA.SA1, D0230, ENUCELL.SA1));


!--- New desciption: Periodic solution at the entrance of CAX.SA1
dofo_SA1_close: Line = (SA1SEC1, SA1SEC2);   ! first quadrupole defocusing
fodo_SA1_close: Line = (SA1SEC2, SA1SEC1);   ! first quadrupole   focusing

!------------------------------------------------------------------------------------------------

!----- SA1

!--- CELL1  without undulator segment
!--- CELL2  with undulator segment
!--- CELL33 with chicane
!--- Matching point at the entrance of CELL3

!--- Undulator segment from CELL33 moved to CELL2
!--- Undulator segment from CELL17 moved to CELL1

comment    
SA1: LINE = (STSEC.SA1.SA1, D029272, SA1DRIF1, SA1SEC2, MATCH.UND.SA1, &
             6*(SA1SEC1, SA1SEC2),                                    &
             SA1SEC1, SA1SEC2, SA1SEC1, SA1SEC2,                      &
             6*(SA1SEC1, SA1SEC2),                                    &
             SA1SEC1, SA1SEC2A, SA1SECSEED2, SA1SEC2,                 &
             SA1SEC1, SA1SEC2,  SA1SEC1E,                             &
             ENSEC.SA1.SA1);
endcomment
!2025 with self-seeding chicane
!comment
SA1: LINE = (STSEC.SA1.SA1, D029272, SA1SEC1, SA1SEC2, MATCH.UND.SA1, &
             6*(SA1SEC1, SA1SEC2),                                    &
             SA1SEC1, SA1SEC2A, SA1SECSEED1, SA1SEC2,                 &
             6*(SA1SEC1, SA1SEC2),                                    &
             SA1SEC1, SA1SEC2A, SA1SECSEED2, SA1SEC2,                 &
             SA1SEC1, SA1SEC2,  SA1SEC1E,                             &
             ENSEC.SA1.SA1);
!endcomment


SA1_CAX: LINE = (STSEC.SA1.SA1, SA1DRIF1, SA1SEC2, MATCH.UND.SA1,      &
                 14*(SA1SEC1, SA1SEC2), SA1SEC1, SA1SEC2A,             &
                 SA1SECSEED1, SA1SEC2, SA1SEC1, SA1SEC2, SA1SEC1E,     &
                 ENSEC.SA1.SA1);

comment
!--- Old definition and without chicane
SA1: LINE = (STSEC.SA1.SA1, (SA1DRIF1, SA1DRIF2), MATCH.UND.SA1, &
             SA1SEC1E, 17*(SA1SEC2, SA1SEC1), ENSEC.SA1.SA1);
endcomment

!SA1: LINE = (STSEC.SA1.SA1, SA1DRIF1, SA1SEC2E, MATCH.UND.SA1,   &
!             15*(SA1SEC1, SA1SEC2),                              &
!             SA1SECSEED1, SA1SEC2, SA1SEC1, SA1SEC2, SA1SEC1,    &
!             ENSEC.SA1.SA1);
          
 
!************************************************************************************************
!
!---------- T4 Beam Transport and Deflection to SASE3 in XS3
!
!************************************************************************************************


!----- Section and Subsection Markers

STSEC.T4.T4:   MARKER;
ENSEC.T4.T4:   MARKER;

STSUB.T4U.T4:  MARKER;   ! Start of subsection from start of T4 up to first photon beamline start
ENSUB.T4U.T4:  MARKER;

STSUB.T4T.T4:  MARKER;   ! Start of subsection from photon beamline start to end of T4 section
ENSUB.T4T.T4:  MARKER;  


!----- Diagnostics Marker

BPMA.T4:  MONITOR;
BPME.T4:  MONITOR;
OTRB.T4:  MARKER;
OTRA.T4:  MARKER;
OTRBW.T4: MARKER;
BAM.T4:   MARKER;
BAMC.T4:  MARKER;
TORA.T4:  MARKER;

PDIO.T4: MARKER;

!----- Vacuum Markers and Vacuum Components

VCSTEP.T4:     MARKER;
VCST40T93X.T4: MARKER;
VCST93XT40.T4: MARKER;
VCST10T22.T4:  MARKER;  
VCST22T40.T4:  MARKER; 
VCBSHUT.T4: DRIFT, L=0.3;


!----- Correctors (L_yoke is used)

CEX.T4:   HKICKER, L = 0.1;
CEX.1.T4: HKICKER, L = 0.1;
CEX.2.T4: HKICKER, L = 0.1;
CEX.3.T4: HKICKER, L = 0.1;
CEY.T4:   VKICKER, L = 0.1;
CFX.T4:   HKICKER, L = 0.1;
CFY.T4:   VKICKER, L = 0.1;
CHX.T4:   HKICKER, L = 0.2;
CHX.1.T4: HKICKER, L = 0.2;
CHY.T4:   VKICKER, L = 0.2;
CNY.T4:   VKICKER, L = 0.3;

ABSP.T4: DRIFT, L = 0.05;


!----- Kicker in the front of SA3

KSPOS.1.T4:  Hkicker, L = LEN_KS/2, KICK  = 0.0;
KSNEG.1.T4:  Hkicker, L = LEN_KS/2, KICK  = 0.0;
KS.1.T4: MARKER;
             
KICK_KST4: LINE=(KSPOS.1.T4, KS.1.T4, KSNEG.1.T4);

!----- Chicane in front of SA3

CBT.1.T4: HKICKER, L=0.0;
CBT.2.T4: HKICKER, L=0.0;
CBT.3.T4: HKICKER, L=0.0;
CBT.4.T4: HKICKER, L=0.0;

!--- Dipoles
!LEN_BT = 0.6;    ! defined in DEFS file

ang_chic_T4 = 0.000;
arc_chic_T4 = LEN_BT;    ! /sin(ang_chic_T2A)*ang_chic_T2A

BT.1.1.T4: SBEND, L = arc_chic_T4, ANGLE = ang_chic_T4, &
                    E1 = 0, E2 = ang_chic_T4, TILT = 0;
BT.1.2.T4: SBEND, L = arc_chic_T4, ANGLE =-ang_chic_T4, &
                    E1 = -ang_chic_T4, E2 = 0, TILT = 0;
BT.1.3.T4: SBEND, L = arc_chic_T4, ANGLE =-ang_chic_T4, &
                    E1 = 0, E2 =-ang_chic_T4, TILT = 0;
BT.1.4.T4: SBEND, L = arc_chic_T4, ANGLE = ang_chic_T4, &
                    E1 = ang_chic_T4, E2 = 0, TILT = 0;


deltachic_T4  = 1.0145;    ! 0.394
D1TO2_T4:  DRIFT, L = deltachic_T4 / cos(ang_chic_T4);

D2TO3_T4: DRIFT, L = 0.341   

CHIC.T4: LINE = &
  (TWOCPPCHIC(BT.1.1.T4,D0000, BT.1.2.T4, D0000,            &
             BT.1.3.T4,CBT.3.T4, BT.1.4.T4,CBT.4.T4, &
             D1TO2_T4, D2TO3_T4));

!------------------------------------------------------------------------------------------------


!-------- FODO cell in T4 (mux = muy = 60 deg): T4LFODO

!----- Quadrupoles 

QE.1.T4: Quadrupole, L = L_QE_eff, K1 = -0.192279551578;
QE.2.T4: Quadrupole, L = L_QE_eff, K1 = +0.192279551578;

T4LFODO: LINE=(D10000, D0450, QESEC(BPMA.T4, QE.2.T4, CEX.T4),  & 
               D10000, &
               D10000, D0935, QESEC(BPMA.T4, QE.1.T4, CEY.T4),  &
               D10000, D0485);

T4LFODOCHIC: LINE=(D2500, CHIC.T4,                              &        
               D2500,  D0450, QESEC(BPMA.T4, QE.2.T4, CEX.T4),  & 
               D10000, &
               D10000, D0935, QESEC(BPMA.T4, QE.1.T4, CEY.T4),  &
               D10000, D0485);

!------------------------------------------------------------------------------------------------


!------- Matching section from SASE1 to T4LFODO: T4MATCH1

!--- Quadrupoles 

!--- Setting: Undulator SASE1 open (default)
QE.3.T4: QUADRUPOLE, L = L_QE_eff, K1 = +0.223792251712;
QE.4.T4: QUADRUPOLE, L = L_QE_eff, K1 = -0.204091452363;
QE.5.T4: QUADRUPOLE, L = L_QE_eff, K1 = +0.240596358538;
QE.6.T4: QUADRUPOLE, L = L_QE_eff, K1 = -0.230659760613;

!D11295: Drift, L = 11.795 - 0.586;

D5000x: DRIFT, L=5-0.074+0.0721-0.305, 
D6209x: DRIFT, L=6.209+0.074-0.0721;
D0305: DRIFT, L=0.305;

T4MATCH1: LINE = (STSUB.T4U.T4,                            &
!                  VCST10T40.T4, D0058, D03325,             &   ! without BAMC
                  VCST10T22.T4, D0258,BAMC.T4,D0042,       &  !2023 insert BAMC
                  VCST22T40.T4,D00905,                     &  !2023 insert BAMC
!                  D0990, TORA.T4, D0300, D0000, D0140,   &
                  D0990, TORA.T4, D0300, PDIO.T4, D0140,   &  !2023 insert PDIO
                  D5138,  QESEC(BPMA.T4, QE.3.T4, CEX.T4), &
                  D11795, QESEC(BPMA.T4, QE.4.T4, CEY.T4), &
                  D11795, QESEC(BPMA.T4, QE.5.T4, CEX.T4), &
!                  D0586, OTRA.T4, D5000, D0000, D6209,     & 
                  D0586, OTRA.T4, D5000x, MIRR2.T4,        &   !2023 insert reflector
                  D0305, RRM2.T4,   D6209x,                &  !2023 insert reflector
                  QESEC(BPMA.T4, QE.6.T4, CEY.T4),         &
                  D8430);

comment
T4MATCH1: LINE = (STSUB.T4U.T4,                            &
                  VCST10T22.T4, D0150,BAMC.T4,D0150,       &  ! insert BAMC, chamber 22 mm
                  VCST22T40.T4, D00905,                    &  ! chamber 22mm
                  D0990, TORA.T4, D0210, D0230,            &
                  D5138,  QESEC(BPMA.T4, QE.3.T4, CEX.T4), &
                  D11795, QESEC(BPMA.T4, QE.4.T4, CEY.T4), &
                  D11795, QESEC(BPMA.T4, QE.5.T4, CEX.T4), &
                  D11795, QESEC(BPMA.T4, QE.6.T4, CEY.T4), &
                  D8430);
endcomment

!------------------------------------------------------------------------------------------------


!-------- Deflection arc T4M
!         angle = (1.318203999257485)*(PI/180.0) = 0.023007 rad


!----- Dipoles (two dipoles)
 
!LEN_BE =  2.5;             ! defined in DEFS file

ANG_T4 = 0.0115035;         ! 0.5*0.023007
ARC_T4 = (0.5*LEN_BE*ANG_T4)/sin(0.5*ANG_T4);
E12_T4 = 0.5 * ANG_T4;

BE.1.T4: Sbend, L = ARC_T4, ANGLE = ANG_T4, &
                E1 = E12_T4, E2 = E12_T4;


!----- Quadrupoles and sextupoles

!--- Setting: QH.1.T4 and QH.2.T4 are used for matching
QH.1.T4: Quadrupole, L = L_QH_eff, K1 = +0.294889644110;
QM.2.T4: Quadrupole, L = L_QM_eff, K1 = -0.288466077501;
QM.1.T4: Quadrupole, L = L_QM_eff, K1 = +0.288229145377;
QH.2.T4: Quadrupole, L = L_QH_eff, K1 = -0.294826790306;

SAOX.1.T4: Sextupole, L = L_SA_eff, K2 = +25.23*0.3/0.3164;
SAOX.2.T4: Sextupole, L = L_SA_eff, K2 =  +8.91*0.3/0.3164;


T4M1: LINE = (D1000, CHX.T4, D0145,                                &
              D0040, CHY.T4, D0040, D0050, D0100, BPMA.T4, D0100,  &
              hD0125, QH.1.T4, hD0125, &
              D0025, VCST40T93X.T4, D0250, ENSUB.T4U.T4);

 
T4M2: LINE = (STSUB.T4T.T4,                                         &
              BE.1.T4, VCST93XT40.T4, D0100,                        &
              D0500, D0025, QMSEC(D0000, QM.2.T4, D0200), D1440,    &
              D1500, D0025, QMSEC(BPMA.T4, QM.1.T4, CHX.T4),        &
              D0515, sD0125, SAOX.1.T4, sD0125, D1900,              &
              QMSEC(BPMA.T4, QM.2.T4, CHY.T4),                      &
              D1165, sD0125, SAOX.2.T4, sD0125, D0920,              &
              D0040, CHX.T4, D0040, D0050, D0100, BPMA.T4, D0100,   &
              D0150, mD0125, QM.1.T4, mD0125, D0275, BE.1.T4,       &
              D0100, D0500, D0175, QHSEC(BPMA.T4, QH.2.T4, CHY.T4), D1590);

T4M: LINE = (T4M1, T4M2);

!------------------------------------------------------------------------------------------------


!-------- Matching from/to FODO lattice (T4LFODO): T4MATCH2

QH.3.T4: QUADRUPOLE, L = L_QH_eff, K1 = -0.196526138301;
QH.4.T4: QUADRUPOLE, L = L_QH_eff, K1 = +0.196531553235;

T4MATCH2: LINE = (D7930, D0175, QHSEC(BPMA.T4, QH.4.T4, CHX.T4), D1230,&
                          D0175, QHSEC(BPMA.T4, QH.3.T4, CHY.T4), D8020);

!------------------------------------------------------------------------------------------------


!-------- Matching to SASE3: T4MATCH4


!----- Diagnsotic undulators with natural focusing
!----- Parameters like for U40S.T2

U40S.T4: MATRIX, L = LundS_3,            &
   RM(1,1) = 1.0,                        &
   RM(1,2) = LundS_3,                    &
   RM(1,3) = 0.0,                        &
   RM(2,2) = 1.0,                        &
   RM(3,3) = cos(OmegaS*LundS_3),        &
   RM(3,4) = sin(OmegaS*LundS_3)/OmegaS, &
   RM(4,3) =-sin(OmegaS*LundS_3)*OmegaS, &
   RM(4,4) = cos(OmegaS*LundS_3);


!----- Quadrupoles 

!--- Setting: Undulator SASE3 open (default)
QF.7.T4:  QUADRUPOLE, L = L_QF_eff, K1 = -0.115601665486;
QF.8.T4:  QUADRUPOLE, L = L_QF_eff, K1 = +0.147541323539;
QF.9.T4:  QUADRUPOLE, L = L_QF_eff, K1 = -0.150513058332;
QF.10.T4: QUADRUPOLE, L = L_QF_eff, K1 = +0.183637635430;

QA.3.T4:  QUADRUPOLE, L = L_QA_eff, K1 = -1.116515943559;     ! not QA.1.SA3
QA.4.T4:  QUADRUPOLE, L = L_QA_eff, K1 = +1.243900966656;     ! not QA.2.SA3


!D1535703: DRIFT, L = 1.535703;     ! Winni's value
D1535703: DRIFT, L = 1.535713;    ! to Winni: Nina's value: for 1e-5 larger

T4MATCH3: LINE = (D0275, OTRBW.T4, D10000, D0175,         &
                  QESEC(BPMA.T4, QE.2.T4, CEX.T4),        &
                  D9860, D10000, D0175,                   &
                  QFSEC(BPMA.T4, QF.7.T4, CFY.T4),        &
                  D5240, D0200, OTRBW.T4, D0400, D5025,   &
                  QFSEC(BPMA.T4, QF.8.T4, CFX.T4),        &
                  D5240, D0200,           D0400, D5025,   &
                  QFSEC(BPMA.T4, QF.9.T4, CFY.T4),        &
                  D5240, D0200, OTRBW.T4, D0400, D5025,   &
                  QFSEC(BPMA.T4, QF.10.T4, CFX.T4),       &
                  D0445, KICK_KST4, D1754987,             &   !!! Insert for Kicker, BPM and Beam Stop in front of SASE3
                  BPMA.T4, D0615, VCBSHUT.T4, D1535703,   &   !!!
                  D0400, TORA.T4, D000675,                &
                  D0500, D0100, VCST40T10.T4, D009975,    &
                  D0100, BPME.T4, D0100,                  &
                  aD0125, QA.3.T4, aD0125, D0035,         &
                  D0025,  CNY.T4, D0125, CEX.T4, D20575,  &
                  D0110, U40S.T4, D0110,                  &
                  D17167, CNY.T4, D0150, CEX.T4, D0160,   &
                  D0050, ABSP.T4, D01723, BPME.T4,        &
                  aD01935, QA.4.T4, aD0047,               &
                  ENSUB.T4T.T4);

!------------------------------------------------------------------------------------------------


!-------- Total T4 line

!SA1TT4: LINE = (T4MATCH1, 1 * T4LFODO, T4MATCH2);
SA1TT4: LINE = (T4MATCH1, 1 * T4LFODOCHIC, T4MATCH2);    !2025: compensation chicane
T4TSA3: LINE = (T4MATCH2, 2 * T4LFODO, T4MATCH3);

T4:     LINE = (STSEC.T4.T4, SA1TT4, T4M, T4TSA3, ENSEC.T4.T4);


!************************************************************************************************
!
!---------- SASE 3 - XTD4 22
!---------- SASE 3 Undulator (23 Sections)
!
!---------- August   2016: 23 Cells, CELL1 and CELL2 are without undulator segments
!---------- December 2019: Undulator segment from CELL13 is moved in CELL2
!
!************************************************************************************************

!----- Section and Subsection Markers

STSEC.SA3.SA3: MARKER;
ENSEC.SA3.SA3: MARKER; 

STSUB.UE90.SA3: MARKER;
ENSUB.UE90.SA3: MARKER;

STUCELL.SA3: MARKER;
ENUCELL.SA3: MARKER;


!----- Matching Markers

MATCH.UND.SA3:  Marker;
MATCH.UE90.SA3: Marker;    ! if needed
 

!----- Steerer
CAX.SA3:  HKICKER, L=0.025;
CAY.SA3:  VKICKER, L=0.025;
CBX.SA3:  HKICKER, L=0.025;
CBY.SA3:  VKICKER, L=0.025;
CUX.SA3:  HKICKER, L=0.000;
CUY.SA3:  HKICKER, L=0.000;
CUSX.SA3: HKICKER, L=0.000;
CUSY.SA3: HKICKER, L=0.000;

!----- Quadrupole movers
CMVQA.SA3: KICKER, L=0;

!----- Monitor
BPME.SA3: MONITOR;
BPMA.SA3: MONITOR;

!----- Phase Shifter
BPS.SA3: DRIFT, L=0.23;

!----- ABSORBER
ABSP.SA3: DRIFT, L=0.05;
ABSP6.SA3: DRIFT, L = 0.05;

!------------------------------------------------------------------------------------------------


!----- Model for undulator natural focusing

!--- Undulator closed (with natural focusing)
!    - model for U68.SA3 has to be set in SET_MODEL_SA3.txm
!    - matching has to be done to periodic solution in SA3
!    - one case: call, "SET_SA3_closed_14GeV_110_b15.txm"


!--- Undulator open (no natural focusing)

U68.SA3: Drift, L = 5.0;


!--- Definition of undulator segment: Open Default

UNDU.SA3: Line = (U68.SA3);

!------------------------------------------------------------------------------------------------


!----- Quadrupoles

!--- Setting of quadrupoles depends on energy, undulator gap, betatron functions

!--- Undulator SASE3 open (default), mean beta-function 15 m
QA.1.SA3:  Quadrupole, L = L_QA_eff, K1 = -1.197430122553;
QA.2.SA3:  Quadrupole, L = L_QA_eff, K1 = +1.197430122553;

!------------------------------------------------------------------------------------------------


!----- Chicane in CELL13

CBSL.1.SA3: HKICKER, L=0.0;
CBSL.2.SA3: HKICKER, L=0.0;
CBSL.3.SA3: HKICKER, L=0.0;
CBSL.4.SA3: HKICKER, L=0.0;


!--- Dipoles

!LEN_BSL = 0.6;    ! defined in DEFS file

ang_chic_SA3 = 0.000;
arc_chic_SA3 = LEN_BSL;    ! /sin(ang_chic_SA3)*ang_chic_SA3

BSL.1.1.SA3: SBEND, L = arc_chic_SA3, ANGLE = ang_chic_SA3, &
                    E1 = 0, E2 = ang_chic_SA3, TILT = 0;
BSL.1.2.SA3: SBEND, L = arc_chic_SA3, ANGLE =-ang_chic_SA3, &
                    E1 = -ang_chic_SA3, E2 = 0, TILT = 0;
BSL.1.3.SA3: SBEND, L = arc_chic_SA3, ANGLE =-ang_chic_SA3, &
                    E1 = 0, E2 =-ang_chic_SA3, TILT = 0;
BSL.1.4.SA3: SBEND, L = arc_chic_SA3, ANGLE = ang_chic_SA3, &
                    E1 = ang_chic_SA3, E2 = 0, TILT = 0;


deltachic_SA3  = 1.068 - 0.6;   
CD0394I = deltachic_SA3 / cos(ang_chic_SA3);
D1TO2:  DRIFT, L = CD0394I;

D2TO3L = 2.034-0.6;
D2TO3I: DRIFT, L = 0.392;
D2TO3II: DRIFT, L = D2TO3L-0.392;


ODL.SA3: MARKER

D2TO3: Line=(D2TO3I, ODL.SA3, D2TO3II)


CHIC.CELL13.SA3: LINE = &
  (TWOCPPCHIC(BSL.1.1.SA3,CBSL.1.SA3, BSL.1.2.SA3,CBSL.2.SA3,            &
             BSL.1.3.SA3,CBSL.3.SA3, BSL.1.4.SA3, CBSL.4.SA3, D1TO2, D2TO3));


comment
CHIC.CELL13.SA3: DRIFT, L=5.000;
endcomment

!------------------------------------------------------------------------------------------------


!----- SA3 Lattice

!----- 
!----- December 2019: Undulator segment from CELL13 is moved in CELL2


!----- Description of one CELL (undulator segments and intersecton): in DEFS file

comment   ! here for info
!--- New Section Definition necessary to correctly handle start/end markers
UNDSEC(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,PHS,END): LINE = &
    (START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,             &
     D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047,              &
     D0058, PHS, D000472, END);

!--- Last Undulator Cell ends before the phase shifter 
UNDSECE(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,END): LINE =    &
    (START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,             &
     D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047, END);

!--- L_UNDSEC = 6.1 m;  L_UNDSECE = 5.80728 m (D0058+PHS+D000472=0.29272m)
endcomment

comment
!--- Old description kept for a while (phase shifter in the beginning)
UNDSEC(START,CAX,CAY,UNDU,CBX,CBY,CL,ABSP,BPM,Q,QMV,PHS,END): LINE =   &
   (D0058, PHS, D000472, END,                                          &
    START, CAX,CAY, D004778, CL, UNDU, D00467, CBX,CBY,                &
    D0050, ABSP, D01723, BPM, aD01935, Q, QMV, aD0047);
endcomment

!------------------------------------------------------------------------------------------------


!----- Cells without undulators segments
!      Aug 2016: CELL1 and CELL2 are without undulator segments
!      Dec 2019: CELL1 without undulator segment
!                CELL2 with chicane, description without segment 
!                is not needed, but kept for studies

!--- Undulator segment as a drift
!UNDULATOR: DRIFT, L = 5.0;
!U00.SA3: UNDULATOR;

!--- Undulator segment is devided in two parts
!--- for cheking of SASE3_Ursprung (deltaZ=2.8905m)

U00.SA3: Marker;
U00Line.SA3: Line = (D2500, U00.SA3, D2500);


!--- CELL1 and CELL2 without undulator segments

SA3DRIF1: LINE = &
  (UNDSEC(STUCELL.SA3, D0025,D0025, U00LINE.SA3, D0025,D0025, CUX.SA3, &
          ABSP.SA3, BPME.SA3, &
          QA.1.SA3, CMVQA.SA3, D0230, ENUCELL.SA3));

SA3DRIF2: LINE = &
  (UNDSEC(STUCELL.SA3, D0025,D0025, U00LINE.SA3, D0025,D0025, CUX.SA3, &
          ABSP.SA3, BPME.SA3, &
          QA.2.SA3, CMVQA.SA3, D0230, ENUCELL.SA3));

!--- Periodic solution at the entrance of CAX.SA3 
dofo_SA3_open: Line = (SA3DRIF1, SA3DRIF2);
fodo_SA3_open: Line = (SA3DRIF2, SA3DRIF1);

!------------------------------------------------------------------------------------------------


!----- Cells with undulator segments

!--- CELL with defocusing (horizontal) quadrupole 
SA3SEC1: LINE = &
  (UNDSEC(STUCELL.SA3, CAX.SA3, CAY.SA3, UNDU.SA3, &
          CBX.SA3, CBY.SA3, CUX.SA3,               &
          ABSP.SA3, BPME.SA3,                      &
          QA.1.SA3, CMVQA.SA3, BPS.SA3, ENUCELL.SA3));

!--- CELL with defocusing (horizontal) quadrupole without Phaseshifter
!--- including 6 mm photon absorner
SA3SEC1A: LINE = &
  (UNDSEC(STUCELL.SA3, CAX.SA3, CAY.SA3, UNDU.SA3, &
          CBX.SA3, CBY.SA3, CUX.SA3,               &
          ABSP6.SA3, BPME.SA3,                      &
          QA.1.SA3, CMVQA.SA3, BPS.SA3, ENUCELL.SA3));

comment   ! not needed
!--- Last Undulator CELL ends before the phase shifter (L = 5.80728 m)
SA3SEC1E: LINE = &
  (UNDSECE(STUCELL.SA3, CAX.SA3, CAY.SA3, UNDU.SA3, &
          CBX.SA3, CBY.SA3, CUX.SA3,                &
          ABSP.SA3, BPME.SA3,                       &
          QA.1.SA3, CMVQA.SA3, ENUCELL.SA3));
endcomment

!--- CELL with focusing (horizontal) quadrupole
SA3SEC2: LINE = &
  (UNDSEC(STUCELL.SA3, CAX.SA3, CAY.SA3, UNDU.SA3, &
          CBX.SA3, CBY.SA3, CUX.SA3,               &
          ABSP.SA3, BPME.SA3,                      &
          QA.2.SA3, CMVQA.SA3, BPS.SA3, ENUCELL.SA3));

!--- CELL in the front of chicane without Phaseshifter BPS.SA1 => D0230
SA3SEC2A: LINE = &
  (UNDSEC(STUCELL.SA3, CAX.SA3, CAY.SA3, UNDU.SA3, &
          CBX.SA3, CBY.SA3, CUX.SA3,               &
          ABSP.SA3, BPME.SA3,                      &
          QA.2.SA3, CMVQA.SA3, D0230, ENUCELL.SA3));

!--- CELL with 6mm photon absorber
SA3SEC2B: LINE = &
  (UNDSEC(STUCELL.SA3, CAX.SA3, CAY.SA3, UNDU.SA3, &
          CBX.SA3, CBY.SA3, CUX.SA3,               &
          ABSP6.SA3, BPME.SA3,                      &
          QA.2.SA3, CMVQA.SA3, BPS.SA3, ENUCELL.SA3));


!--- CELL 13 with chicane (with Phaseshifter)

SA3TWOCPP: LINE = &
  (UNDSEC(STUCELL.SA3, D0025,D0025, CHIC.CELL13.SA3 , D0025,D0025, D0000, &
          ABSP.SA3, BPME.SA3, &
          QA.1.SA3, CMVQA.SA3, BPS.SA3, ENUCELL.SA3));


!--- Periodic solutions at the entrance of CAX.SA3
dofo_SA3_close: Line =(SA3SEC1, SA3SEC2);
fodo_SA3_close: Line =(SA3SEC2, SA3SEC1);


!************************************************************************************************
!
!----- Description of afterburner section UE90
!          
!----- 24.06.2019, Suren: Afterburner section UE90 
!        Length (one FODO period) = 14.8 m
!        Intersections like in SA3
!        4 x UE90 undulators (2.6 m reserved space for each)
!        4 x phase shifters
!        4 x BPME
!        2 x QA quadrupoles
!
!************************************************************************************************

            
!----- Model for undulator UE90 natural focusing

!--- Undulator closed (with natural focusing) 
!--- 08.01.2020: not introduced 

!--- Undulator open (no natural focusing)
 
L_UE90 = 1.98;

D03285: DRIFT, L = 0.3285-0.1-0.0325;
D02915: DRIFT, L = 0.2915-0.1-0.0325;
D00325: DRIFT, L = 0.0325;

UE90.SA3:  Drift,  L = L_UE90;
MVUE90.SA3: MARKER

QP.SA3: Quadrupole, L = 0.1, k1 = 0.0

!--- Definition of undulator UE90: Default Open

UNDU.UE90: Line = (D03285, QP.SA3, D00325, UE90.SA3, MVUE90.SA3, &
D00325, QP.SA3, D02915);  ! L = 0.3285+1.98+0.2915 = 2.6 m


!D0990: Drift, L = L_UE90/2;   ! D0990 is defined in DEFS file
!MIDUE90.SA3: MARKER;
!UNDU.UE90: Line = (D03285, D0990, MIDUE90.SA3, D0990, D02915);

!------------------------------------------------------------------------------------------------


!----- Drift for missing quadrupoles in two intersections

D01137:   Drift, L = 0.1137;     ! QA effective length
CMVQA.NO: Drift, L = 0.0;


!--- 06.01.2020. Two ambient magnetic field correctors: CUX, CUY

CU.SA3: Line = (CUSX.SA3, CUSY.SA3);
!CU.SA3: Line = (D0000, D0000);

!------------------------------------------------------------------------------------------------


!----- UE90 Lattice

comment
!--- UE90 Lattice without Apple-X undulators

!--- 1st and 3d cells: without quadrupoles, with Phaseshifters and BPM's
UE90SECQ: LINE = &
  (UNDSEC(STUCELL.SA3, D0025,D0025, UNDU.UE90,    &
          D0025,D0025, CU.SA3,                    &
          ABSP.SA3, BPME.SA3, D01137, CMVQA.NO, D0230, ENUCELL.SA3));

!--- 2d cell: with focusing quadrupole, Phaseshifter and BPM
UE90SEC2: LINE = &
  (UNDSEC(STUCELL.SA3, D0025,D0025, UNDU.UE90,     &
          D0025,D0025, CU.SA3,                     &
          ABSP.SA3, BPME.SA3, QA.2.SA3, CMVQA.SA3, D0230, ENUCELL.SA3));

!--- 4th cell: with defocusing quadrupole and BPM, without Phaseshifter
UE90SEC1: LINE = &
  (UNDSECE(STUCELL.SA3, D0025,D0025, UNDU.UE90,   &
          D0025,D0025, CU.SA3,                    &
          ABSP.SA3, BPME.SA3, QA.1.SA3, CMVQA.SA3, ENUCELL.SA3));
endcomment

!comment
!--- Version from 01.01.2022 with Phaseshiters

!--- 1st and 3d cells: without quadrupoles, with Phaseshifters and BPM's
UE90SECQ: LINE = &
  (UNDSEC(STUCELL.SA3, CAX.SA3,CAY.SA3, UNDU.UE90,    &
          CBX.SA3,CBY.SA3, CU.SA3,                    &
          ABSP.SA3, BPME.SA3, D01137, CMVQA.NO, BPS.SA3, ENUCELL.SA3));

!--- 2d cell: with focusing quadrupole, Phaseshifter, BPM and 6 mm absorber
UE90SEC2: LINE = &
  (UNDSEC(STUCELL.SA3,CAX.SA3,CAY.SA3, UNDU.UE90,     &
          CBX.SA3,CBY.SA3, CU.SA3,                    &
          ABSP6.SA3, BPME.SA3, QA.2.SA3, CMVQA.SA3, BPS.SA3, ENUCELL.SA3));

!--- 4th cell: with defocusing quadrupole and BPM, without Phaseshifter
UE90SEC1: LINE = &
  (UNDSECE(STUCELL.SA3, CAX.SA3,CAY.SA3, UNDU.UE90,   &
          CBX.SA3,CBY.SA3, CU.SA3,                    &
          ABSP.SA3, BPME.SA3, QA.1.SA3, CMVQA.SA3, ENUCELL.SA3));
!endcomment


