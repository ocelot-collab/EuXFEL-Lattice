!----- Afterburner section with 4 UE90 undulators

UE90: Line = (STSUB.UE90.SA3,                         &
              UE90SECQ, UE90SEC2, UE90SECQ, UE90SEC1, &
              ENSUB.UE90.SA3);


!----- Afterburner FODO period (contains 4 x UE90 undulators),
!----- to find the periodic solution for studies.
!----- Last CELL in SA3 with Phaseshifter

fodo_UE90: Line = (UE90SECQ, UE90SEC2, UE90SECQ, UE90SEC1, D029272);
!fodo_UE90: Line = (D029272, UE90SECQ, UE90SEC2, UE90SECQ, UE90SEC1);

