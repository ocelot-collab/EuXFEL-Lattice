GainA13.L3 = Gain.L3/N.RF.L3;
GainA14.L3 = Gain.L3/N.RF.L3;
GainA15.L3 = Gain.L3/N.RF.L3;
GainA16.L3 = Gain.L3/N.RF.L3;
GainA17.L3 = Gain.L3/N.RF.L3;
GainA18.L3 = Gain.L3/N.RF.L3;
GainA19.L3 = Gain.L3/N.RF.L3;
GainA20.L3 = Gain.L3/N.RF.L3;
GainA21.L3 = Gain.L3/N.RF.L3;
GainA22.L3 = Gain.L3/N.RF.L3;
GainA23.L3 = Gain.L3/N.RF.L3;
GainA24.L3 = Gain.L3/N.RF.L3;
GainA25.L3 = Gain.L3/N.RF.L3;


!--- Energy gain per cavity 

GainA6.L3.Cav  = GainA6.L3/4/8;
GainA7.L3.Cav  = GainA7.L3/4/8;
GainA8.L3.Cav  = GainA8.L3/4/8;
GainA9.L3.Cav  = GainA9.L3/4/8;
GainA10.L3.Cav = GainA10.L3/4/8;
GainA11.L3.Cav = GainA11.L3/4/8;
GainA12.L3.Cav = GainA12.L3/4/8;
GainA13.L3.Cav = GainA13.L3/4/8;
GainA14.L3.Cav = GainA14.L3/4/8;
GainA15.L3.Cav = GainA15.L3/4/8;
GainA16.L3.Cav = GainA16.L3/4/8;
GainA17.L3.Cav = GainA17.L3/4/8;
GainA18.L3.Cav = GainA18.L3/4/8;
GainA19.L3.Cav = GainA19.L3/4/8;
GainA20.L3.Cav = GainA20.L3/4/8;
GainA21.L3.Cav = GainA21.L3/4/8;
GainA22.L3.Cav = GainA22.L3/4/8;
GainA23.L3.Cav = GainA23.L3/4/8;
GainA24.L3.Cav = GainA24.L3/4/8;
GainA25.L3.Cav = GainA25.L3/4/8;


!--- Last 16 modules - not in the beamline 2016

GainA26.L3 = 0.0;
GainA27.L3 = 0.0;
GainA28.L3 = 0.0;
GainA29.L3 = 0.0;

GainA26.L3.Cav = GainA26.L3/4/8;
GainA27.L3.Cav = GainA27.L3/4/8;
GainA28.L3.Cav = GainA28.L3/4/8;
GainA29.L3.Cav = GainA29.L3/4/8;

!************************************************************************************************


!--- Linac 3 cavities (MAD definition)

!relerr:=0e-3;

C.A6.L3:  LCAVITY, L=0.1153*9, PHI0=0/360,    &
                   DELTAE=GainA6.L3.Cav,      &
                   FREQ=1300000000.0*1e-6,volterr=20*relerr;
C.A7.L3:  LCAVITY, L=0.1153*9, PHI0=0/360,    &
                   DELTAE=GainA7.L3.Cav,      &
                   FREQ=1300000000.0*1e-6,volterr=20*relerr;
